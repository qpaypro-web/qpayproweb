# Variables del formulario de contacto (/api/lead).
#
# Este archivo es solo la plantilla: no lleva valores reales y sí se commitea.
#
#  - PUBLIC_*  se compila dentro del sitio y es visible para cualquiera.
#              Va en un .env local y en las variables de build de Cloudflare.
#  - El resto  son secretos de servidor. NUNCA les pongas el prefijo PUBLIC_:
#              quedarían dentro del JS que descarga el navegador.
#              Se cargan en Cloudflare Pages → Settings → Variables and Secrets,
#              como tipo "Secret", en Production y en Preview.
#              Para desarrollo local van en un archivo .dev.vars (ignorado).

# --- Zoho (secretos de servidor, obligatorios) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Captcha: o las dos, o ninguna ---
# Sin ellas el formulario funciona igual, protegido solo por el honeypot, la
# validación del servidor y el límite por IP. Configurar una sola deja el sitio
# en un estado roto; ver functions/README.md.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Servidor (opcionales, texto plano) ---
# Datacenter de la cuenta de Zoho. Por defecto accounts.zoho.com (EE.UU.).
# Si el Self Client se creó en api-console.zoho.eu, aquí va accounts.zoho.eu.
ZOHO_ACCOUNTS_HOST=
# Normalmente no hace falta: Zoho devuelve el api_domain correcto junto con el
# access_token. Solo se usa como respaldo.
ZOHO_API_HOST=
