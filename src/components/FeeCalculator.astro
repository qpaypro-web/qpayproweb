---
import Icon from './Icon.astro';
import { getCountry, withCountry } from './../lib/country';

interface Props {
  country: string;
}

const { country } = Astro.props;
const calc = getCountry(country).calculator;

// Guatemala y El Salvador no comparten ni la base de la comisión, ni el IVA,
// ni el concepto de retención, así que cada país tiene su propio bloque de
// markup y su propia función de cálculo. Mezclarlos en una sola fórmula
// parametrizada es justo el error que advierte la especificación: en
// El Salvador la comisión del contribuyente se calcula sobre monto / 1.13,
// no sobre el monto total, y no existe el pequeño contribuyente.
const hasInstallments = calc.installments === true;

const INSTALLMENTS = hasInstallments ? calc.installmentRates : [];

// Guatemala cobra también en dólares. Las tasas, los regímenes y la fórmula de
// retención son las mismas en las dos monedas: lo único que cambia es el costo
// administrativo fijo y el umbral a partir del cual el pequeño contribuyente
// sufre retención (Q2,500 allá, $300 acá). Por eso las monedas son dos filas de
// la misma tabla y no dos funciones de cálculo distintas.
const GT = hasInstallments
  ? {
      rates: calc.installmentRates,
      iva: calc.iva,
      smallTaxpayerRate: calc.smallTaxpayerRate,
      generalRetentionRate: calc.generalRetentionRate,
      currencies: {
        GTQ: {
          symbol: 'Q',
          locale: 'es-GT',
          fixedCost: calc.fixedCost,
          threshold: calc.smallTaxpayerThreshold,
        },
        USD: {
          symbol: '$',
          locale: 'en-US',
          fixedCost: calc.fixedCostUsd,
          threshold: calc.smallTaxpayerThresholdUsd,
        },
      },
    }
  : null;

const SV = hasInstallments
  ? null
  : {
      commission: calc.commission,
      iva: calc.iva,
      retention: calc.retention,
      notes: calc.notes,
      exemptNote: calc.exemptNote,
    };
---

<section class="w-full bg-white py-24 lg:py-32">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
    <div class="flex flex-col gap-10 lg:grid lg:grid-cols-2 lg:gap-20 lg:items-center">
      <div class="order-2 w-full max-w-[460px] lg:order-1">
      <div class="rounded-[28px] bg-white shadow-[0_40px_90px_-50px_rgba(15,32,108,0.5)] border border-black/[0.05] overflow-hidden" data-calc>
        <div class="bg-[#f6f7f9] p-7 lg:p-8 border-b border-black/[0.05]">
          <h2 class="text-center text-[#0f206c] text-xl font-bold tracking-tight mb-5">Ingresa el monto</h2>
          {hasInstallments && (
            <div class="flex justify-center mb-5">
              <div class="inline-flex items-center rounded-full bg-white border border-black/10 p-1" role="group" aria-label="Moneda del cálculo">
                <button type="button" data-calc-currency="GTQ" aria-pressed="true" class="px-5 py-2 rounded-full text-sm font-semibold transition-all bg-[#0047ba] text-white">Quetzales</button>
                <button type="button" data-calc-currency="USD" aria-pressed="false" class="px-5 py-2 rounded-full text-sm font-semibold transition-all text-[#5c606b] hover:text-[#0f206c]">Dólares</button>
              </div>
            </div>
          )}
          <div class="flex items-center gap-2 rounded-full bg-white border border-black/10 px-5 py-3.5 mb-6 focus-within:border-[#0047ba] transition-colors">
            <span class="text-[#0047ba] font-bold" data-calc-symbol>{hasInstallments ? 'Q' : '$'}</span>
            <input
              type="text"
              inputmode="decimal"
              value="100.00"
              data-calc-amount
              class="flex-1 bg-transparent outline-none text-center text-[#0f206c] text-2xl font-semibold tracking-tight"
            />
          </div>
          {hasInstallments ? (
            <div class="flex gap-3 mb-5">
              <button type="button" data-calc-regime="pequeno" data-active="true" class="flex-1 min-w-0 rounded-2xl border-2 p-5 flex flex-col items-center gap-3 transition-all duration-300 border-[#0047ba] bg-[#0047ba]/[0.04] shadow-[0_10px_30px_-16px_rgba(0,71,186,0.5)]">
                <span data-calc-regime-icon class="inline-flex w-14 h-14 rounded-2xl items-center justify-center transition-colors bg-gradient-to-br from-[#0f206c] to-[#0097ce]">
                  <Icon name="rocket" class="w-6 h-6 text-white" strokeWidth={1.8} />
                </span>
                <span class="flex items-center gap-2">
                  <span data-calc-regime-dot class="w-3.5 h-3.5 flex-shrink-0 rounded-full border-2 flex items-center justify-center border-[#0047ba]">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0047ba]"></span>
                  </span>
                  <span data-calc-regime-label class="text-sm font-semibold text-center text-[#0f206c]">Pequeño Contribuyente</span>
                </span>
              </button>
              <button type="button" data-calc-regime="general" data-active="false" class="flex-1 min-w-0 rounded-2xl border-2 p-5 flex flex-col items-center gap-3 transition-all duration-300 border-black/10 bg-white hover:border-black/20">
                <span data-calc-regime-icon class="inline-flex w-14 h-14 rounded-2xl items-center justify-center transition-colors bg-[#f0f2f6]">
                  <Icon name="building2" class="w-6 h-6 text-[#8a8f9a]" strokeWidth={1.8} />
                </span>
                <span class="flex items-center gap-2">
                  <span data-calc-regime-dot class="w-3.5 h-3.5 flex-shrink-0 rounded-full border-2 flex items-center justify-center border-black/25"></span>
                  <span data-calc-regime-label class="text-sm font-semibold text-center text-[#5c606b]">Régimen General</span>
                </span>
              </button>
            </div>
          ) : (
            <div class="flex gap-3">
              <button type="button" data-calc-regime="contribuyente" data-active="true" class="flex-1 min-w-0 rounded-2xl border-2 p-5 flex flex-col items-center gap-3 transition-all duration-300 border-[#0047ba] bg-[#0047ba]/[0.04] shadow-[0_10px_30px_-16px_rgba(0,71,186,0.5)]">
                <span data-calc-regime-icon class="inline-flex w-14 h-14 rounded-2xl items-center justify-center transition-colors bg-gradient-to-br from-[#0f206c] to-[#0097ce]">
                  <Icon name="building2" class="w-6 h-6 text-white" strokeWidth={1.8} />
                </span>
                <span class="flex items-center gap-2">
                  <span data-calc-regime-dot class="w-3.5 h-3.5 flex-shrink-0 rounded-full border-2 flex items-center justify-center border-[#0047ba]">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0047ba]"></span>
                  </span>
                  <span data-calc-regime-label class="text-sm font-semibold text-center text-[#0f206c]">Contribuyente de IVA</span>
                </span>
              </button>
              <button type="button" data-calc-regime="exento" data-active="false" class="flex-1 min-w-0 rounded-2xl border-2 p-5 flex flex-col items-center gap-3 transition-all duration-300 border-black/10 bg-white hover:border-black/20">
                <span data-calc-regime-icon class="inline-flex w-14 h-14 rounded-2xl items-center justify-center transition-colors bg-[#f0f2f6]">
                  <Icon name="rocket" class="w-6 h-6 text-[#8a8f9a]" strokeWidth={1.8} />
                </span>
                <span class="flex items-center gap-2">
                  <span data-calc-regime-dot class="w-3.5 h-3.5 flex-shrink-0 rounded-full border-2 flex items-center justify-center border-black/25"></span>
                  <span data-calc-regime-label class="text-sm font-semibold text-center text-[#5c606b]">No contribuyente</span>
                </span>
              </button>
            </div>
          )}
          {hasInstallments && (
            <div class="relative">
              <select data-calc-installments class="w-full appearance-none rounded-full bg-white border border-black/10 px-5 py-3.5 text-[#3a3d47] text-sm font-medium outline-none focus:border-[#0047ba] transition-colors cursor-pointer">
                {INSTALLMENTS.map((item, i) => (
                  <option value={i}>{item.label}</option>
                ))}
              </select>
              <Icon name="chevron-down" class="w-4 h-4 text-[#8a8f9a] absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none" />
            </div>
          )}
        </div>
        <div class="p-7 lg:p-8">
          <p class="text-center text-[#5c606b] text-sm font-semibold mb-1.5">Para esta venta recibes:</p>
          <p class="text-center text-[#0047ba] text-5xl font-bold tracking-[-0.03em] mb-8" data-calc-net>{hasInstallments ? 'Q 92.55' : '$ 94.73'}</p>
          <div class="border-t border-black/[0.08] pt-5 mb-5">
            <div class="flex items-center gap-1.5 mb-1">
              <span class="text-[#0f206c] text-sm font-semibold" data-calc-commission-label>{hasInstallments ? 'Comisión de pago' : 'Comisión Qpaypro (3.5%)'}</span>
              <Icon name="info" class="w-3.5 h-3.5 text-[#b6bac2]" />
            </div>
            <p class="text-[#1a1d29] text-xl font-semibold" data-calc-commission>{hasInstallments ? 'Q 7.45' : '$ 3.10'}</p>
          </div>
          {!hasInstallments && (
            <div class="border-t border-black/[0.08] pt-5 mb-5" data-calc-iva-row>
              <div class="flex items-center gap-1.5 mb-1">
                <span class="text-[#0f206c] text-sm font-semibold">IVA de la comisión (13%)</span>
                <Icon name="info" class="w-3.5 h-3.5 text-[#b6bac2]" />
              </div>
              <p class="text-[#1a1d29] text-xl font-semibold" data-calc-iva>$ 0.40</p>
            </div>
          )}
          <div class="border-t border-black/[0.08] pt-5">
            <div class="flex items-center gap-1.5 mb-1">
              <span class="text-[#0f206c] text-sm font-semibold" data-calc-retention-label>{hasInstallments ? 'Retención de IVA (5%)' : 'Retención Anticipo 2% IVA'}</span>
              <Icon name="info" class="w-3.5 h-3.5 text-[#b6bac2]" />
            </div>
            <p class="text-[#1a1d29] text-xl font-semibold" data-calc-retention>{hasInstallments ? 'Q 0.00' : '$ 1.77'}</p>
          </div>
        </div>
      </div>
      {hasInstallments ? (
        <p class="text-[#9094a0] text-xs mt-6 leading-relaxed">Cálculo referencial. Incluye comisión (<span data-calc-rate>4,50%</span>) y costo administrativo de <span data-calc-admin>Q2.95</span>. La retención aplica según tu régimen y monto.</p>
      ) : (
        <div class="mt-6 space-y-2">
          <p class="text-[#9094a0] text-xs leading-relaxed" data-calc-exempt-note hidden>{SV!.exemptNote}</p>
          {SV!.notes.map((note) => (
            <p class="text-[#9094a0] text-xs leading-relaxed">{note}</p>
          ))}
        </div>
      )}
      </div>

      <div class="contents lg:block lg:order-2">
        <div class="order-1 text-left">
          <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Calcula tu cobro</p>
          <h2 class="text-[#1a1d29] text-4xl md:text-5xl font-bold tracking-tight leading-[1.08] mb-6">Empezar ahora</h2>
          <p class="text-[#5c606b] text-lg leading-relaxed mb-5 max-w-md">Descubre cuánto recibes por cada venta, sin sorpresas ni letra pequeña. Afíliate hoy y empieza a cobrar con Qpaypro.</p>
          <p class="inline-flex items-center gap-2 text-[#0047ba] text-[15px] font-semibold mb-9">
            <Icon name="circle-check" class="w-4 h-4" />
            La comisión se cobra en cada cobro exitoso.
          </p>
        </div>
        <div class="order-3">
          <a href={withCountry(country, "/precios")} class="inline-flex items-center gap-2 px-8 py-4 bg-[#0047ba] text-white rounded-full font-semibold text-base hover:bg-[#0f206c] transition-colors duration-300">Afiliarme</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ GT, SV, hasInstallments }}>
  const root = document.querySelector('[data-calc]');
  const amountInput = root.querySelector('[data-calc-amount]');
  const installmentsSelect = root.querySelector('[data-calc-installments]');
  const regimeButtons = Array.from(root.querySelectorAll('[data-calc-regime]'));
  const currencyButtons = Array.from(root.querySelectorAll('[data-calc-currency]'));
  const symbolEl = root.querySelector('[data-calc-symbol]');
  const adminEl = document.querySelector('[data-calc-admin]');
  const netEl = root.querySelector('[data-calc-net]');
  const commissionEl = root.querySelector('[data-calc-commission]');
  const commissionLabelEl = root.querySelector('[data-calc-commission-label]');
  const ivaEl = root.querySelector('[data-calc-iva]');
  const retentionEl = root.querySelector('[data-calc-retention]');
  const retentionLabelEl = root.querySelector('[data-calc-retention-label]');
  const rateEl = document.querySelector('[data-calc-rate]');
  const exemptNoteEl = document.querySelector('[data-calc-exempt-note]');

  let regime = hasInstallments ? 'pequeno' : 'contribuyente';
  let currency = 'GTQ';

  const formatUSD = (n) => '$ ' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  const decimales = { minimumFractionDigits: 2, maximumFractionDigits: 2 };

  // Guatemala: comisión sobre el monto total + costo administrativo fijo, y la
  // retención depende del régimen (pequeño contribuyente por umbral, general
  // sobre la base sin IVA). En dólares cambian solo el costo fijo y el umbral;
  // todo lo demás es idéntico.
  function renderGT() {
    const config = GT.currencies[currency];
    const money = (n) => config.symbol + ' ' + n.toLocaleString(config.locale, decimales);

    const amount = parseFloat(amountInput.value) || 0;
    const rate = GT.rates[Number(installmentsSelect.value)].rate;

    let retention = 0;
    let retentionLabel = 'Retención de IVA';
    if (regime === 'pequeno') {
      // El umbral no se retiene a sí mismo: la retención empieza justo encima
      // (Q2,500.01 en quetzales, $300.01 en dólares).
      retention = amount > config.threshold ? GT.smallTaxpayerRate * amount : 0;
      retentionLabel = `Retención de IVA (${GT.smallTaxpayerRate * 100}%)`;
    } else {
      retention = (amount / (1 + GT.iva)) * GT.iva * GT.generalRetentionRate;
    }

    const commission = amount * rate + config.fixedCost;
    const net = Math.max(0, amount - commission - retention);

    netEl.textContent = money(net);
    commissionEl.textContent = money(commission);
    retentionEl.textContent = money(retention);
    retentionLabelEl.textContent = retentionLabel;
    rateEl.textContent = (rate * 100).toFixed(2).replace('.', ',') + '%';
    symbolEl.textContent = config.symbol;
    // Sin espacio, como se escribe un precio: "Q2.95", "$0.36".
    adminEl.textContent = config.symbol + config.fixedCost.toLocaleString(config.locale, decimales);
  }

  // El Salvador: si el comercio es contribuyente de IVA, la comisión se calcula
  // sobre la base SIN IVA (monto / 1.13) y el adquirente retiene además el IVA
  // de la comisión y el 2% de anticipo a cuenta de IVA (Art. 162-A CT). Si es
  // exento, la comisión va sobre el monto total y no hay retenciones.
  function renderSV() {
    const amount = parseFloat(amountInput.value) || 0;
    const isTaxpayer = regime === 'contribuyente';

    const base = isTaxpayer ? amount / (1 + SV.iva) : amount;
    const commission = base * SV.commission;
    const ivaCommission = isTaxpayer ? commission * SV.iva : 0;
    const retention = isTaxpayer ? base * SV.retention : 0;
    const net = Math.max(0, amount - commission - ivaCommission - retention);

    netEl.textContent = formatUSD(net);
    commissionEl.textContent = formatUSD(commission);
    ivaEl.textContent = formatUSD(ivaCommission);
    retentionEl.textContent = formatUSD(retention);
    commissionLabelEl.textContent = isTaxpayer
      ? 'Comisión Qpaypro (3.5%)'
      : 'Comisión Qpaypro (3.5%, IVA incluido)';
    if (exemptNoteEl) exemptNoteEl.hidden = isTaxpayer;
  }

  const render = hasInstallments ? renderGT : renderSV;

  amountInput.addEventListener('input', () => {
    amountInput.value = amountInput.value.replace(',', '.').replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');
    render();
  });
  installmentsSelect?.addEventListener('change', render);

  regimeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      regime = btn.dataset.calcRegime;
      regimeButtons.forEach((b) => {
        const active = b === btn;
        b.dataset.active = String(active);
        b.classList.remove('border-[#0047ba]', 'bg-[#0047ba]/[0.04]', 'shadow-[0_10px_30px_-16px_rgba(0,71,186,0.5)]', 'border-black/10', 'bg-white', 'hover:border-black/20');
        b.classList.add(...(active ? ['border-[#0047ba]', 'bg-[#0047ba]/[0.04]', 'shadow-[0_10px_30px_-16px_rgba(0,71,186,0.5)]'] : ['border-black/10', 'bg-white', 'hover:border-black/20']));

        const iconWrap = b.querySelector('[data-calc-regime-icon]');
        iconWrap.classList.remove('bg-gradient-to-br', 'from-[#0f206c]', 'to-[#0097ce]', 'bg-[#f0f2f6]');
        iconWrap.classList.add(...(active ? ['bg-gradient-to-br', 'from-[#0f206c]', 'to-[#0097ce]'] : ['bg-[#f0f2f6]']));
        const icon = iconWrap.querySelector('svg');
        icon.classList.remove('text-white', 'text-[#8a8f9a]');
        icon.classList.add(active ? 'text-white' : 'text-[#8a8f9a]');

        const dot = b.querySelector('[data-calc-regime-dot]');
        dot.classList.remove('border-[#0047ba]', 'border-black/25');
        dot.classList.add(active ? 'border-[#0047ba]' : 'border-black/25');
        dot.innerHTML = active ? '<span class="w-1.5 h-1.5 rounded-full bg-[#0047ba]"></span>' : '';

        const label = b.querySelector('[data-calc-regime-label]');
        label.classList.remove('text-[#0f206c]', 'text-[#5c606b]');
        label.classList.add(active ? 'text-[#0f206c]' : 'text-[#5c606b]');
      });
      render();
    });
  });

  currencyButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      currency = btn.dataset.calcCurrency;
      currencyButtons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('bg-[#0047ba]', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('text-[#5c606b]', !active);
        b.classList.toggle('hover:text-[#0f206c]', !active);
      });
      render();
    });
  });

  render();
</script>
