---
// Shared decorative background (two blurred rotating orbs + the hover-ring
// glow-cube styles) reused by every dark feature section on this page.
---

<style>
  @keyframes dfx-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .dfx-orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(70px);
    opacity: 0.22;
    animation: dfx-spin 20s linear infinite;
    pointer-events: none;
  }
  @keyframes dfx-loadtwo {
    50% {
      transform: rotate(-80deg);
    }
  }
  .dfx-cube {
    position: relative;
    width: 190px;
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dfx-cube__color,
  .dfx-cube__glow {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 38px;
  }
  .dfx-cube__color {
    z-index: 1;
    filter: blur(6px);
    background: linear-gradient(135deg, #0f206c, #0047ba);
    animation: dfx-loadtwo 2.5s ease-in-out infinite;
  }
  .dfx-cube__glow {
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.12);
    border: 2px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .dfx-ring {
    position: absolute;
    inset: -2px;
    border-radius: 14px;
    background: conic-gradient(from 0deg, #0f206c, #0047ba, #0f206c);
    opacity: 0;
    transition: opacity 0.4s;
    animation: dfx-spin 4s linear infinite;
  }
  .group:hover .dfx-ring {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .dfx-orb,
    .dfx-cube__color,
    .dfx-ring {
      animation: none !important;
    }
  }
</style>
<div
  class="dfx-orb"
  style="width: 420px; height: 420px; top: -90px; right: -70px; background: linear-gradient(135deg, rgb(15, 32, 108), rgb(0, 71, 186));"
>
</div>
<div
  class="dfx-orb"
  style="width: 360px; height: 360px; bottom: -110px; left: -80px; background: linear-gradient(135deg, rgb(0, 71, 186), rgb(15, 32, 108)); animation-direction: reverse;"
>
</div>
