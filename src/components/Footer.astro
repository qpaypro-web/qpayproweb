---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const SOCIALS = [
  { icon: 'twitter', label: 'X' },
  { icon: 'linkedin', label: 'LinkedIn' },
  { icon: 'youtube', label: 'YouTube' },
  { icon: 'instagram', label: 'Instagram' },
  { icon: 'facebook', label: 'Facebook' },
];

const COLUMNS = [
  { title: 'Producto', links: ['Pagos', 'Terminal POS'] },
  { title: 'Soluciones', links: ['E-commerce', 'Retail', 'Marketplace'] },
  { title: 'Qpaypro', links: ['Blog', 'Sobre Qpaypro', 'Seguridad'] },
];

const CONTACT_LINES = [
  'Guatemala +(502) 2355-6000',
  'El Salvador +(503) 2208-2300',
  'WhatsApp +(502) 4785-6011',
  'soporte@qpaypro.com',
];

const POLICY_LINKS = ['Política de privacidad', 'Términos del servicio', 'Seguridad'];
---

<footer class="w-full bg-[#050506] py-16 lg:py-20">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-10 mb-14">
      <div class="col-span-2">
        <Logo variant="colored" class="h-7 w-auto mb-6 brightness-0 invert" />
        <p class="text-white/55 text-sm mb-8 max-w-xs leading-relaxed">La plataforma de pagos moderna para negocios que quieren crecer.</p>
        <div class="flex items-center gap-3 flex-wrap">
          {SOCIALS.map((s) => (
            <a href="#" aria-label={s.label} class="w-9 h-9 bg-white/[0.06] border border-white/15 hover:border-white/40 hover:bg-white/10 rounded-lg flex items-center justify-center transition-colors">
              <Icon name={s.icon} class="w-4 h-4 text-white" strokeWidth={1.75} />
            </a>
          ))}
        </div>
      </div>

      {COLUMNS.map((col) => (
        <div>
          <h4 class="text-white font-semibold text-sm mb-4">{col.title}</h4>
          <ul class="space-y-3">
            {col.links.map((link) => (
              <li><a href="#" class="text-white/55 hover:text-white transition-colors text-sm">{link}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h4 class="text-white font-semibold text-sm mb-4">Contacto</h4>
        <ul class="space-y-3">
          {CONTACT_LINES.map((line) => (
            <li class="text-white/55 text-sm leading-relaxed">{line}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="h-px bg-white/10 mb-8"></div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-5">
      <p class="text-white/40 text-sm">© 2026 Qpaypro. Todos los derechos reservados.</p>
      <div class="flex items-center gap-7 text-sm">
        {POLICY_LINKS.map((link) => (
          <a href="#" class="text-white/55 hover:text-white transition-colors">{link}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
