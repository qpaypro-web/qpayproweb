---
/**
 * Botón flotante de WhatsApp. Va en MainLayout, así que aparece en todas las
 * páginas del sitio.
 *
 * El número es el de ventas de Guatemala y se usa igual desde El Salvador: es
 * el canal que atiende el equipo comercial de los dos países.
 *
 * El enlace apunta a api.whatsapp.com a propósito: AnalyticsEvents.astro
 * escucha los clics sobre `a[href]` que coincidan con ese dominio y dispara
 * `whatsapp_click`. Cambiar el host a wa.me también funciona, pero mantenerlo
 * igual que el resto del sitio evita que ese evento deje de contarse.
 */
const NUMERO = '50247856011';
const HREF = `https://api.whatsapp.com/send/?phone=${NUMERO}`;
---

<a
  href={HREF}
  target="_blank"
  rel="noreferrer"
  data-whatsapp-fab
  aria-label="Hablar con ventas por WhatsApp"
  class="group fixed z-[80] bottom-5 right-5 sm:bottom-7 sm:right-7 flex items-center gap-0 rounded-full bg-[#25d366] text-white shadow-[0_12px_34px_-8px_rgba(37,211,102,0.6)] ring-1 ring-black/[0.06] hover:shadow-[0_16px_40px_-8px_rgba(37,211,102,0.75)] hover:-translate-y-0.5 transition-all duration-300 print:hidden"
>
  <span class="flex items-center justify-center w-14 h-14 sm:w-[58px] sm:h-[58px] flex-shrink-0">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-7 h-7 sm:w-[30px] sm:h-[30px]">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.83 9.83 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.548 4.142 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.688 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413"
      />
    </svg>
  </span>
  <!-- La etiqueta se despliega al pasar el cursor: en reposo el botón es solo
       el círculo, para no competir con el contenido ni tapar el banner de
       cookies. En táctil no hay hover, así que ahí siempre queda el círculo. -->
  <span
    class="hidden sm:block max-w-0 overflow-hidden whitespace-nowrap text-[15px] font-semibold group-hover:max-w-[190px] group-hover:pr-6 transition-all duration-300"
  >
    Hablar con ventas
  </span>
</a>

<style>
  /* El banner de cookies ocupa la parte baja de la pantalla mientras el
     visitante no elige. Con z-[80] contra el z-[90] del banner, el botón queda
     por debajo y no estorba la decisión; al cerrarse, vuelve a quedar libre. */
  [data-whatsapp-fab] {
    animation: waFabIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.6s both;
  }

  @keyframes waFabIn {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-whatsapp-fab] {
      animation: none;
    }
    [data-whatsapp-fab]:hover {
      transform: none;
    }
  }
</style>
