---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  /** 'onDark' = white text (nav floats over a colorful/dark hero image).
   *  'onLight' = dark text (nav floats over a plain light section). */
  theme?: 'onDark' | 'onLight';
}

const { theme = 'onLight' } = Astro.props;
const onDark = theme === 'onDark';

const PRODUCTOS = [
  { href: '/pos-cute', icon: 'smartphone', title: 'POS Cute', subtitle: 'Terminal portátil con NFC y chip' },
  { href: '/sistema-pos', icon: 'store', title: 'Punto de Venta', subtitle: 'Sistema POS completo para tu negocio' },
  { href: '/integraciones', icon: 'plug', title: 'Integraciones', subtitle: 'Conecta con las plataformas que usas' },
  { href: '/pasarela-de-pagos', icon: 'layers', title: 'Soluciones', subtitle: 'Herramientas para cada tipo de negocio' },
];

const DESARROLLADORES = [
  { href: 'https://developers.qpaypro.com/', icon: 'file-code', title: 'Documentación API', subtitle: 'Guías y referencia para integrar', external: true },
  { href: 'https://qpaypro.zohodesk.com/portal/es/kb/payments/integraciones', icon: 'puzzle', title: 'Plugins', subtitle: 'Conectores listos para tu plataforma', external: true },
];

const EMPRESA_Y_RECURSOS = [
  { href: '/sobre-qpaypro', icon: 'building2', title: 'Sobre Qpaypro', subtitle: 'Conoce quiénes somos' },
  { href: '/seguridad', icon: 'shield-check', title: 'Seguridad', subtitle: 'Cómo protegemos cada transacción' },
  { href: '/partners', icon: 'handshake', title: 'Partners', subtitle: 'Programa de socios y alianzas' },
];

const SOPORTE = [
  { href: 'https://api.whatsapp.com/send/?phone=50247856011&text&type=phone_number&app_absent=0', icon: 'message-circle', title: 'Soporte WhatsApp', subtitle: 'Atención directa por WhatsApp', external: true },
  { href: 'https://qpaypro.zohodesk.com/portal/es/home', icon: 'life-buoy', title: 'Centro de ayuda Qpaypro', subtitle: 'Resuelve dudas sobre Qpaypro', external: true },
  { href: 'https://help.shopsettings.com/hc/es', icon: 'shopping-bag', title: 'Centro de ayuda Qpayshop', subtitle: 'Ayuda para tu tienda en línea', external: true },
];

// Mirrors the original mobile menu's exact order: Productos, Precios,
// Desarrolladores, Soporte, Empresa y Recursos, Contacto.
const MOBILE_MENU_ENTRIES = [
  { type: 'group' as const, label: 'Productos', items: PRODUCTOS },
  { type: 'link' as const, href: '/precios', label: 'Precios' },
  { type: 'group' as const, label: 'Desarrolladores', items: DESARROLLADORES },
  { type: 'group' as const, label: 'Soporte', items: SOPORTE },
  { type: 'group' as const, label: 'Empresa y Recursos', items: EMPRESA_Y_RECURSOS },
  { type: 'link' as const, href: '/contacto', label: 'Contacto' },
];

const INGRESA = [
  { href: 'https://app.qpaypro.com', icon: 'building2', title: 'Ingreso Qpaypro', external: true },
  { href: 'https://my.shopsettings.com/p/qpayshop', icon: 'shopping-bag', title: 'Ingreso Qpayshop', external: true },
];

const pillClass = onDark
  ? 'bg-white/[0.08] backdrop-blur-[25px] shadow-md shadow-black/[0.04]'
  : 'bg-gray-900/[0.20] backdrop-blur-[24px] shadow-md shadow-black/[0.08]';
const pillBorder = onDark ? 'rgba(255, 255, 255, 0.2)' : 'rgba(255, 255, 255, 0.15)';
const linkClass = onDark
  ? 'text-white/90 hover:text-white hover:bg-white/10'
  : 'text-gray-800/90 hover:text-gray-900 hover:bg-gray-900/10';
const ingresaBtnClass = onDark
  ? 'bg-white text-gray-900 hover:shadow-xl hover:shadow-white/30'
  : 'bg-gray-900 text-white hover:shadow-xl hover:shadow-gray-900/30';
const hamburgerClass = onDark
  ? 'text-white/90 hover:bg-white/10'
  : 'text-gray-800/90 hover:bg-gray-900/10';
---

<nav class="fixed top-4 left-0 right-0 z-50 transition-all duration-500" data-header>
  <div class="max-w-[1400px] mx-auto px-6">
    <div class={`relative rounded-2xl transition-all duration-500 ${pillClass}`} style={`border: 1px solid ${pillBorder};`}>
      <div class="flex items-center justify-between px-5 py-3">
        <a href="/" class="flex items-center flex-shrink-0">
          <Logo variant={onDark ? 'white' : 'colored'} class="h-6 transition-all duration-500" />
        </a>

        <div class="hidden lg:flex items-center gap-0.5 absolute left-1/2 -translate-x-1/2">
          <div class="relative" data-dropdown data-hover-dropdown>
            <button class={`flex items-center gap-1 px-3.5 py-2 transition-all duration-300 rounded-lg font-medium text-sm whitespace-nowrap ${linkClass}`} data-dropdown-trigger>
              <span>Productos</span>
              <Icon name="chevron-down" class="w-3.5 h-3.5" />
            </button>
            <div class="absolute top-full left-0 mt-2 w-72 rounded-2xl bg-white shadow-2xl shadow-black/15 p-2 hidden" style="border: 1px solid rgba(0, 0, 0, 0.08);" data-dropdown-panel>
              {PRODUCTOS.map((item) => (
                <a href={item.href} class="flex items-start gap-3 p-3.5 rounded-xl transition-all group hover:bg-[#f6f7f9]">
                  <Icon name={item.icon} class="w-5 h-5 text-[#0047ba] flex-shrink-0 mt-0.5 group-hover:scale-110 transition-transform" />
                  <div>
                    <div class="font-semibold text-sm mb-0.5 text-[#1a1d29]">{item.title}</div>
                    <div class="text-xs leading-relaxed text-[#5c606b]">{item.subtitle}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <a href="/precios" class={`px-3.5 py-2 transition-all duration-300 rounded-lg font-medium text-sm whitespace-nowrap ${linkClass}`}>Precios</a>

          <div class="relative" data-dropdown data-hover-dropdown>
            <button class={`flex items-center gap-1 px-3.5 py-2 transition-all duration-300 rounded-lg font-medium text-sm whitespace-nowrap ${linkClass}`} data-dropdown-trigger>
              <span>Desarrolladores</span>
              <Icon name="chevron-down" class="w-3.5 h-3.5" />
            </button>
            <div class="absolute top-full left-0 mt-2 w-72 rounded-2xl bg-white shadow-2xl shadow-black/15 p-2 hidden" style="border: 1px solid rgba(0, 0, 0, 0.08);" data-dropdown-panel>
              {DESARROLLADORES.map((item) => (
                <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined} class="flex items-start gap-3 p-3.5 rounded-xl transition-all group hover:bg-[#f6f7f9]">
                  <Icon name={item.icon} class="w-5 h-5 text-[#0047ba] flex-shrink-0 mt-0.5 group-hover:scale-110 transition-transform" />
                  <div>
                    <div class="font-semibold text-sm mb-0.5 text-[#1a1d29]">{item.title}</div>
                    <div class="text-xs leading-relaxed text-[#5c606b]">{item.subtitle}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <div class="relative" data-dropdown data-hover-dropdown>
            <button class={`flex items-center gap-1 px-3.5 py-2 transition-all duration-300 rounded-lg font-medium text-sm whitespace-nowrap ${linkClass}`} data-dropdown-trigger>
              <span>Empresa y Recursos</span>
              <Icon name="chevron-down" class="w-3.5 h-3.5" />
            </button>
            <div class="absolute top-full left-0 mt-2 w-72 rounded-2xl bg-white shadow-2xl shadow-black/15 p-2 hidden" style="border: 1px solid rgba(0, 0, 0, 0.08);" data-dropdown-panel>
              {EMPRESA_Y_RECURSOS.map((item) => (
                <a href={item.href} class="flex items-start gap-3 p-3.5 rounded-xl transition-all group hover:bg-[#f6f7f9]">
                  <Icon name={item.icon} class="w-5 h-5 text-[#0047ba] flex-shrink-0 mt-0.5 group-hover:scale-110 transition-transform" />
                  <div>
                    <div class="font-semibold text-sm mb-0.5 text-[#1a1d29]">{item.title}</div>
                    <div class="text-xs leading-relaxed text-[#5c606b]">{item.subtitle}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <a href="/contacto" class={`px-3.5 py-2 transition-all duration-300 rounded-lg font-medium text-sm whitespace-nowrap ${linkClass}`}>Contacto</a>
        </div>

        <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
          <div class="hidden lg:block relative" data-dropdown data-hover-dropdown>
            <button class={`flex items-center gap-1 px-3.5 py-2 transition-all duration-300 rounded-lg font-medium text-sm whitespace-nowrap ${linkClass}`} data-dropdown-trigger>
              <span>Soporte</span>
              <Icon name="chevron-down" class="w-3.5 h-3.5" />
            </button>
            <div class="absolute top-full right-0 mt-2 w-72 rounded-2xl bg-white shadow-2xl shadow-black/15 p-2 hidden" style="border: 1px solid rgba(0, 0, 0, 0.08);" data-dropdown-panel>
              {SOPORTE.map((item) => (
                <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined} class="flex items-start gap-3 p-3.5 rounded-xl transition-all group hover:bg-[#f6f7f9]">
                  <Icon name={item.icon} class="w-5 h-5 text-[#0047ba] flex-shrink-0 mt-0.5 group-hover:scale-110 transition-transform" />
                  <div>
                    <div class="font-semibold text-sm mb-0.5 text-[#1a1d29]">{item.title}</div>
                    <div class="text-xs leading-relaxed text-[#5c606b]">{item.subtitle}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <div class="relative" data-dropdown data-hover-dropdown>
            <button class={`flex items-center gap-1.5 px-4 sm:px-5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:scale-105 ${ingresaBtnClass}`} data-dropdown-trigger>
              Ingresa
              <Icon name="chevron-down" class="w-3.5 h-3.5 transition-transform" />
            </button>
            <div class="absolute top-full right-0 mt-2 w-64 rounded-2xl bg-white shadow-2xl shadow-black/15 p-2 hidden" style="border: 1px solid rgba(0, 0, 0, 0.08);" data-dropdown-panel>
              {INGRESA.map((item) => (
                <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined} class="flex items-center gap-3 p-3.5 rounded-xl transition-all group hover:bg-[#f6f7f9]">
                  <Icon name={item.icon} class="w-5 h-5 text-[#0047ba] flex-shrink-0" />
                  <div class="font-semibold text-sm text-[#1a1d29]">{item.title}</div>
                </a>
              ))}
            </div>
          </div>

          <button class={`lg:hidden p-2 transition-all duration-300 rounded-lg ${hamburgerClass}`} data-mobile-menu-trigger aria-label="Abrir menú">
            <Icon name="menu" class="w-6 h-6" data-mobile-menu-icon-open />
            <Icon name="x" class="w-6 h-6 hidden" data-mobile-menu-icon-close />
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="lg:hidden fixed inset-0 z-40 mt-20 hidden" data-mobile-menu>
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-mobile-menu-backdrop></div>
    <div class="relative max-w-sm mx-auto mt-2 rounded-2xl backdrop-blur-[30px] shadow-2xl shadow-black/15 bg-white/98 max-h-[80vh] overflow-y-auto" style="border: 1px solid rgba(0, 0, 0, 0.08); margin-left: 1.5rem; margin-right: 1.5rem;">
      <div class="p-4 space-y-1">
        {MOBILE_MENU_ENTRIES.map((entry) =>
          entry.type === 'link' ? (
            <a href={entry.href} class="block px-3 py-3 rounded-lg font-semibold text-sm text-[#1a1d29] hover:bg-[#f6f7f9]">{entry.label}</a>
          ) : (
            <div class="border-b border-[#eef0f3] last:border-0 pb-1" data-mobile-submenu>
              <button class="w-full flex items-center justify-between px-3 py-3 rounded-lg font-semibold text-sm text-[#1a1d29] hover:bg-[#f6f7f9]" data-mobile-submenu-trigger>
                {entry.label}
                <Icon name="chevron-down" class="w-4 h-4 transition-transform" />
              </button>
              <div class="hidden pl-2 pb-2 space-y-0.5" data-mobile-submenu-panel>
                {entry.items.map((item) => (
                  <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined} class="block px-3 py-2 rounded-lg text-sm text-[#5c606b] hover:bg-[#f6f7f9]">
                    {item.title}
                  </a>
                ))}
              </div>
            </div>
          )
        )}
        <div class="pt-3 space-y-2">
          <a href="https://app.qpaypro.com" target="_blank" rel="noreferrer" class="block w-full text-center px-5 py-3 rounded-xl font-semibold text-sm bg-[#0047ba] text-white hover:bg-[#0f206c] transition-colors">Ingresa</a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  function setupDropdowns(root: ParentNode) {
    const dropdowns = root.querySelectorAll<HTMLElement>('[data-dropdown]');

    function closeAll(except?: HTMLElement) {
      dropdowns.forEach((dd) => {
        if (dd === except) return;
        dd.querySelector<HTMLElement>('[data-dropdown-panel]')?.classList.add('hidden');
      });
    }

    dropdowns.forEach((dd) => {
      const trigger = dd.querySelector<HTMLElement>('[data-dropdown-trigger]');
      const panel = dd.querySelector<HTMLElement>('[data-dropdown-panel]');
      if (!trigger || !panel) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !panel.classList.contains('hidden');
        closeAll(dd);
        panel.classList.toggle('hidden', isOpen);
      });

      if (dd.hasAttribute('data-hover-dropdown')) {
        let closeTimer: ReturnType<typeof setTimeout>;
        dd.addEventListener('mouseenter', () => {
          clearTimeout(closeTimer);
          closeAll(dd);
          panel.classList.remove('hidden');
        });
        dd.addEventListener('mouseleave', () => {
          closeTimer = setTimeout(() => panel.classList.add('hidden'), 200);
        });
      }
    });

    document.addEventListener('click', () => closeAll());
  }

  function setupMobileMenu(root: ParentNode) {
    const trigger = root.querySelector<HTMLElement>('[data-mobile-menu-trigger]');
    const menu = root.querySelector<HTMLElement>('[data-mobile-menu]');
    const backdrop = root.querySelector<HTMLElement>('[data-mobile-menu-backdrop]');
    const iconOpen = root.querySelector<HTMLElement>('[data-mobile-menu-icon-open]');
    const iconClose = root.querySelector<HTMLElement>('[data-mobile-menu-icon-close]');
    if (!trigger || !menu) return;

    function setOpen(open: boolean) {
      menu.classList.toggle('hidden', !open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    }

    trigger.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });
    backdrop?.addEventListener('click', () => setOpen(false));

    root.querySelectorAll<HTMLElement>('[data-mobile-submenu]').forEach((group) => {
      const subTrigger = group.querySelector<HTMLElement>('[data-mobile-submenu-trigger]');
      const subPanel = group.querySelector<HTMLElement>('[data-mobile-submenu-panel]');
      const chevron = subTrigger?.querySelector('svg');
      subTrigger?.addEventListener('click', () => {
        const isOpen = !subPanel?.classList.contains('hidden');
        subPanel?.classList.toggle('hidden', isOpen);
        chevron?.classList.toggle('rotate-180', !isOpen);
      });
    });
  }

  const header = document.querySelector('[data-header]');
  if (header) {
    setupDropdowns(header);
    setupMobileMenu(header);
  }
</script>
