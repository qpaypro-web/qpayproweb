---
// Shared "Todo, en una sola plataforma" network diagram — verified byte-identical
// across all 5 sector pages (retail/servicios/ecommerce/belleza/clinicas), so it's
// a single static component with no per-sector data.
//
// The one-time entrance choreography (nodes fading/scaling in, connector lines
// "drawing" via stroke-dashoffset) is rendered in its settled final state rather
// than reimplementing the original scroll-triggered timeline — the continuous
// decorative motion (orbiting light dots via native SVG <animateMotion>, the
// floating logo, the rotating background orbs) is native CSS/SVG and still works.

import { getCountry } from '../lib/country';

interface Props {
  country: string;
}

const { country } = Astro.props;

// Las suscripciones no están habilitadas en El Salvador. El diagrama tiene seis
// nodos en posiciones fijas con sus líneas trazadas, así que quitar uno dejaría
// un hueco y una línea huérfana: en su lugar ese nodo nombra otra cosa cierta,
// y el icono de flechas en ciclo le queda igual de bien a la liquidación diaria.
const suscripciones = getCountry(country).features.subscriptions;
const nodoRecurrente = suscripciones ? 'Suscripciones' : 'Liquidación diaria';
const tercerCanal = suscripciones ? 'suscripciones' : 'código QR';
---

<section class="relative w-full overflow-hidden bg-[#050506] py-24 lg:py-32"><style>
        @keyframes dfx-spin { to { transform: rotate(360deg); } }
        .dfx-orb { position:absolute; border-radius:9999px; filter:blur(70px); opacity:0.22; animation: dfx-spin 20s linear infinite; pointer-events:none; }
        @keyframes dfx-loadtwo { 50% { transform: rotate(-80deg); } }
        .dfx-cube { position: relative; width: 190px; height: 190px; display:flex; align-items:center; justify-content:center; }
        .dfx-cube__color, .dfx-cube__glow { position:absolute; width:100%; height:100%; border-radius:38px; }
        .dfx-cube__color { z-index:1; filter: blur(6px); background: linear-gradient(135deg,#0f206c,#0047ba); animation: dfx-loadtwo 2.5s ease-in-out infinite; }
        .dfx-cube__glow { z-index:2; display:flex; align-items:center; justify-content:center; background-color: rgba(255,255,255,0.12); border: 2px solid rgba(255,255,255,0.28); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
        .dfx-ring { position:absolute; inset:-2px; border-radius:14px; background: conic-gradient(from 0deg,#0f206c,#0047ba,#0f206c); opacity:0; transition:opacity .4s; animation: dfx-spin 4s linear infinite; }
        .group:hover .dfx-ring { opacity:1; }
        @media (prefers-reduced-motion: reduce){ .dfx-orb,.dfx-cube__color,.dfx-ring { animation:none !important; } }
      </style><div class="dfx-orb" style="width: 420px; height: 420px; top: -90px; right: -70px; background: linear-gradient(135deg, rgb(15, 32, 108), rgb(0, 71, 186));"></div><div class="dfx-orb" style="width: 360px; height: 360px; bottom: -110px; left: -80px; background: linear-gradient(135deg, rgb(0, 71, 186), rgb(15, 32, 108)); animation-direction: reverse;"></div><style>
        @keyframes cpFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
        .cp-iso{animation:cpFloat 5s ease-in-out infinite}
        @media (prefers-reduced-motion:reduce){.cp-iso{animation:none}}
