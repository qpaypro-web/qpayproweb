---
import Icon from './Icon.astro';
import { idDeEncabezado, type Bloque } from '../lib/blog';

interface Props {
  body: Bloque[];
  country: string;
}

const { body, country } = Astro.props;

// El texto de los bloques trae solo strong, em y a: el conversor descarta el resto del HTML del
// WordPress. Por eso se puede renderizar con set:html sin arrastrar estilos ajenos.
---

<div class="blog-prose">
  {
    body.map((b) => {
      switch (b.type) {
        case 'h2':
          return (
            <h2
              id={idDeEncabezado(b.text!)}
              class="text-[#0f0f12] text-[26px] md:text-[28px] font-semibold tracking-[-0.02em] leading-[1.2] mt-14 mb-5 scroll-mt-28 first:mt-0"
              set:html={b.text}
            />
          );
        case 'h3':
          return (
            <h3
              class="text-[#0f0f12] text-xl font-semibold tracking-[-0.01em] leading-snug mt-10 mb-3"
              set:html={b.text}
            />
          );
        case 'ul':
          return (
            <ul class="space-y-3 mb-7 mt-1">
              {b.items!.map((item) => (
                <li class="flex items-start gap-3.5">
                  <span class="mt-[10px] w-1.5 h-1.5 rounded-full bg-[#0047ba] flex-shrink-0" />
                  <span class="text-[#3a3d47] text-[17px] leading-[1.7] font-light" set:html={item} />
                </li>
              ))}
            </ul>
          );
        case 'ol':
          return (
            <ol class="space-y-3 mb-7 mt-1">
              {b.items!.map((item, i) => (
                <li class="flex items-start gap-3.5">
                  <span
                    class="mt-0.5 w-6 h-6 rounded-full bg-[#0047ba]/[0.08] text-[#0047ba] text-xs font-bold flex items-center justify-center flex-shrink-0"
                    style="font-family: var(--font-brand);"
                  >
                    {i + 1}
                  </span>
                  <span class="text-[#3a3d47] text-[17px] leading-[1.7] font-light" set:html={item} />
                </li>
              ))}
            </ol>
          );
        case 'quote':
          return (
            <blockquote class="border-l-2 border-[#0047ba] pl-6 my-9">
              <p class="text-[#1a1d29] text-lg lg:text-xl leading-[1.6] font-light italic" set:html={b.text} />
            </blockquote>
          );
        case 'callout':
          return (
            <div class="rounded-[20px] bg-[#0047ba]/[0.045] ring-1 ring-[#0047ba]/[0.12] p-6 my-9">
              <div class="flex items-start gap-3.5">
                <Icon name="info" class="w-5 h-5 text-[#0047ba] flex-shrink-0 mt-0.5" />
                <p class="text-[#1a1d29] text-[16px] leading-[1.65]" set:html={b.text} />
              </div>
            </div>
          );
        case 'cta':
          return (
            <div class="rounded-[24px] bg-[#f5f6f8] ring-1 ring-black/[0.05] p-7 lg:p-8 my-10">
              <p class="text-[#1a1d29] text-[17px] leading-[1.6] mb-6" set:html={b.text} />
              <div class="flex flex-wrap items-center gap-3">
                <a
                  href={`/${country}/precios`}
                  class="group inline-flex items-center gap-2 px-6 py-3 bg-[#0047ba] text-white rounded-full font-semibold text-sm hover:bg-[#0f206c] transition-colors duration-300"
                >
                  Ver planes y precios
                  <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
                </a>
                <a
                  href={`/${country}/contacto#ventas`}
                  class="inline-flex items-center px-6 py-3 rounded-full font-semibold text-sm text-[#1a1d29] ring-1 ring-black/10 hover:ring-black/25 transition-all duration-300"
                >
                  Hablar con ventas
                </a>
              </div>
            </div>
          );
        default:
          return (
            <p class="text-[#3a3d47] text-[17px] leading-[1.75] font-light mb-6" set:html={b.text} />
          );
      }
    })
  }
</div>

<style>
  /* El formato en línea que sobrevive del WordPress: negrita, cursiva y enlaces. Se estilan
     aquí porque llegan por set:html y no pueden llevar clases de utilidad. */
  .blog-prose :global(strong) {
    font-weight: 600;
    color: #1a1d29;
  }
  .blog-prose :global(em) {
    font-style: italic;
  }
  .blog-prose :global(a) {
    color: #0047ba;
    text-decoration: underline;
    text-decoration-color: rgb(0 71 186 / 0.3);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }
  .blog-prose :global(a:hover) {
    text-decoration-color: #0047ba;
  }
</style>
