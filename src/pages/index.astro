---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import FeeCalculator from '../components/FeeCalculator.astro';

const LOGO_MARQUEE = [
  'b4d76d9ae1e3.webp',
  'af394dadba86.webp',
  '205c5c5959a9.webp',
  '7838a6195770.webp',
  '074ab750fffb.webp',
  '4a1ec1f15495.webp',
  '456898459a21.webp',
  'd63e92cb3cb0.webp',
];

const SOLUTIONS_CARDS = [
  { title: 'Soluciones de Cobros', href: '/pasarela-de-pagos', image: '3b1c939fd3af.webp', textClass: 'text-white', shadow: true },
  { title: 'Punto de Venta', href: '/sistema-pos', image: '77a587fbf8a2.webp', textClass: 'text-[#001853]', shadow: false },
  { title: 'Tienda en Línea', href: '/tiendas-en-linea', image: 'bc92e09e11da.webp', textClass: 'text-white', shadow: true },
];

const SECTOR_PANELS = [
  { key: 'retail', title: 'Retail', headline: 'Vende en tienda y en línea sin perder el control', text: 'Gestiona ventas, inventario y sucursales desde un solo lugar, sincronizado en tiempo real.', href: '/retail', image: '5e1c9b9bc2b1.webp' },
  { key: 'servicios', title: 'Servicios', headline: 'Agenda, cobra y organiza sin esfuerzo', text: 'Desde citas hasta cobros frecuentes, administra tu negocio de servicios con menos fricción.', href: '/servicios', image: '9c171b51f890.webp' },
  { key: 'ecommerce', title: 'Ecommerce', headline: 'Tu tienda online, conectada a todo', text: 'Vende en línea con control total de tu operación: pagos, inventario y clientes en un sistema.', href: '/ecommerce', image: 'f282850f8f3c.webp' },
  { key: 'belleza', title: 'Belleza', headline: 'Salones y spas que fluyen sin esperas', text: 'Agenda citas, cobra y fideliza a tus clientes con una experiencia impecable de principio a fin.', href: '/belleza', image: '7f02c8855693.webp' },
  { key: 'clinicas', title: 'Clínicas', headline: 'Atiende, cobra y da seguimiento con orden', text: 'Gestiona pagos, membresías y cobros frecuentes para que tu clínica opere sin fricción.', href: '/clinicas', image: '03c36a961a82.webp' },
];

const FEATURES = [
  {
    title: 'Cobros en línea',
    text: 'Links de pago, QR y suscripciones.',
    path: '<path d="M16 6L8 15.5H14L12 22L20 12.5H14L16 6Z" fill="currentColor"></path>',
  },
  {
    title: 'Punto de venta',
    text: 'POS Cute y terminal para tu local.',
    path: '<circle cx="14" cy="14" r="7" fill="currentColor"></circle><circle cx="14" cy="14" r="3.5" fill="white"></circle><circle cx="14" cy="14" r="1.2" fill="currentColor"></circle>',
  },
  {
    title: 'Todo en una plataforma',
    text: 'Ventas, inventario y reportes juntos.',
    path: '<path d="M14 5L7 8V14C7 18 10.5 21.5 14 23C17.5 21.5 21 18 21 14V8L14 5Z" fill="currentColor"></path><path d="M11 14L13 16L17 12" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>',
  },
  {
    title: 'Integraciones',
    text: 'Conecta Shopify, WooCommerce y más.',
    path: '<path d="M11 9L6 14L11 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M17 9L22 14L17 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>',
  },
];

const SECURITY_ITEMS = [
  { num: '01', icon: 'shield', title: 'Protección avanzada', text: 'Validación y encriptación de extremo a extremo en cada transacción.', tag: 'AES-256' },
  { num: '02', icon: 'eye', title: 'Monitoreo 24/7', text: 'Detección de riesgo y anomalías en tiempo real, todos los días.', tag: 'Tiempo real' },
  { num: '03', icon: 'file-check', title: 'Cumplimiento PCI DSS', text: 'Certificación de seguridad internacional para pagos con tarjeta.', tag: 'Nivel 1' },
  { num: '04', icon: 'lock', title: 'Datos protegidos', text: 'Tu información y la de tus clientes, siempre cifrada y resguardada.', tag: 'Cifrado' },
  { num: '05', icon: 'fingerprint', title: 'Tokenización', text: 'Los datos sensibles se reemplazan por tokens irreversibles.', tag: 'PAN seguro' },
  { num: '06', icon: 'server-cog', title: 'Infraestructura robusta', text: 'Servidores redundantes con monitoreo y respaldo continuo.', tag: '99.9% uptime' },
];

const PLATFORM_ITEMS = [
  { title: 'Plataforma de pagos', text: 'Cobros automáticos, links de pago, QR y suscripciones. Todo desde una sola pasarela.', image: 'b133d792fa04.webp' },
  { title: 'Tienda en línea', text: 'Crea y conecta tu tienda en línea con pagos integrados, lista para vender desde el primer día.', image: '0893ae5d2362.webp' },
  { title: 'Integraciones', text: 'Vincula tu tienda de Shopify, WooCommerce, OpenCart, Vtex y más a nuestra pasarela de pagos.', image: '8f12055aabe0.webp' },
  { title: 'POS Cute', text: 'Terminal portátil con NFC y chip para cobrar en grande desde la palma de tu mano.', image: '33a00fd88103.webp' },
  { title: 'Punto de venta', text: 'Sistema completo con pantalla táctil, inventario y reportes en tiempo real para tu negocio.', image: 'ba93fc8c7d72.webp' },
];

const TESTIMONIALS = [
  { text: 'Descubrí Qpaypro y se me hizo súper fácil afiliarme. En menos de 48 horas ya estaba cobrando.', name: 'Najelee Gálvez', company: 'NayeNails', image: '56d68b9a2125.webp' },
  { text: 'Qpayshop me facilitó el trabajo: fácil de integrar, ver inventarios y recibir mis pagos sin complicaciones.', name: 'Ana Cecilia Guerra', company: 'ByAnaCeci', image: 'f14b74902338.webp' },
  { text: 'Ha sido la herramienta segura que le da confianza a mis clientes y que hizo crecer mis ventas.', name: 'Ana Lucía', company: 'Laluh', image: '5d04962f8c9e.webp' },
];
---

<MainLayout
  title="Qpaypro: Cobra, opera y crece con una sola plataforma"
  description="Una plataforma para cobrar, operar y crecer: pagos en línea, punto de venta y tienda en línea para tu negocio en Guatemala y El Salvador."
  headerTheme="onDark"
>
  <section class="relative w-full h-screen overflow-hidden">
    <div class="absolute inset-0 w-full h-full">
      <video autoplay loop playsinline muted class="absolute inset-0 w-full h-full object-cover">
        <source src="/images/index/47e13c35c6d9.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="relative z-10 h-full w-full flex items-center justify-center pt-24 px-4 sm:px-8">
      <div class="max-w-[1440px] mx-auto w-full">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-white text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-[6rem] mb-1 sm:mb-2 leading-[0.95] uppercase whitespace-nowrap" style="font-family: var(--font-manrope); font-weight: 700; letter-spacing: 0.04em;">Una plataforma</h1>
          <p class="text-white text-lg sm:text-xl md:text-2xl" style="font-family: var(--font-manrope); font-weight: 300;">Para cobrar, operar y crecer</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 px-4 mt-10 sm:mt-12">
            <a href="/precios" class="group w-full sm:w-auto px-6 sm:px-8 py-3 sm:py-4 bg-white text-[#0f206c] rounded-full font-semibold text-sm sm:text-base hover:shadow-2xl hover:shadow-[#0097ce]/40 hover:-translate-y-0.5 transition-all duration-300 flex items-center justify-center gap-2">
              Empieza gratis
              <Icon name="arrow-right" class="w-4 h-4 sm:w-5 sm:h-5 group-hover:translate-x-1 transition-transform" />
            </a>
            <a href="/contacto#ventas" class="group w-full sm:w-auto px-6 sm:px-8 py-3 sm:py-4 bg-white/10 backdrop-blur-md text-white rounded-full font-semibold text-sm sm:text-base border-2 border-white/30 hover:bg-white/20 hover:border-white/50 transition-all duration-300 flex items-center justify-center gap-2">Hablar con asesor</a>
          </div>
          <div class="mt-8 sm:mt-12 flex items-center justify-center gap-4 sm:gap-6 text-white/60 text-xs sm:text-sm px-4">
            <div class="flex items-center gap-2"><span class="text-center">Más de 800,000 usuarios activos</span></div>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 z-20 pb-7 lg:pb-10 overflow-hidden pointer-events-none">
      <style>
        @keyframes logoMarqH { from { transform: translateX(0); } to { transform: translateX(-50%); } }
        .logo-marqH { animation: logoMarqH 45s linear infinite; width: max-content; }
        @media (prefers-reduced-motion: reduce) { .logo-marqH { animation: none; } }
      </style>
      <div class="relative">
        <div class="logo-marqH flex items-center gap-[42px] lg:gap-[68px]">
          {[...LOGO_MARQUEE, ...LOGO_MARQUEE].map((logo) => (
            <img src={`/images/index/${logo}`} alt="" aria-hidden="true" class="h-[18px] lg:h-8 w-auto object-contain opacity-90 flex-shrink-0" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="w-full bg-white py-28 lg:py-36">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="mb-10 lg:mb-12 max-md:bg-[#f6f7f9] max-md:rounded-2xl max-md:p-7 max-md:shadow-[0_10px_40px_rgba(10,31,143,0.08)]" data-reveal>
        <h2 class="text-2xl md:text-3xl lg:text-[2.1rem] font-bold tracking-[-0.01em] leading-snug max-w-4xl mx-auto text-center">
          <span class="text-[#1a1d29]">Soluciones.</span> <span class="text-[#86898f]">Una para cada forma de vender: en tu local, por chat o en línea.</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6">
        {SOLUTIONS_CARDS.map((card) => (
          <div class="h-full">
            <a href={card.href} class="group relative block h-[520px] rounded-[1.75rem] overflow-hidden shadow-[0_4px_20px_rgba(10,31,143,0.08)] hover:shadow-[0_30px_70px_rgba(10,31,143,0.18)] transition-shadow duration-500">
              <img src={`/images/index/${card.image}`} alt={card.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05]" />
              <div class="absolute inset-x-0 top-0 p-8 text-center" style={card.shadow ? 'text-shadow: rgba(5, 8, 20, 0.45) 0px 1px 12px;' : 'text-shadow: none;'}>
                <h3 class={`text-[1.7rem] font-bold tracking-[-0.01em] mb-3 ${card.textClass}`}>{card.title}</h3>
                <span class={`inline-flex items-center gap-1.5 font-semibold text-sm group-hover:gap-2.5 transition-all ${card.textClass}`}>
                  Más información
                  <Icon name="arrow-right" class="w-4 h-4" />
                </span>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative w-full min-h-screen flex items-center py-28 overflow-hidden bg-[#050506]">
    <video src="/images/index/b94aba71be7a.mp4" autoplay loop playsinline muted aria-hidden="true" class="absolute inset-0 w-full h-full object-cover"></video>
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center" data-reveal>
        <div class="flex items-center justify-center gap-2.5 mb-7">
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
          <p class="text-white/60 text-xs font-semibold uppercase tracking-[0.24em]" style="font-family: var(--font-brand);">Hardware</p>
        </div>
        <h2 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold tracking-[-0.03em] leading-[1.05] mb-10" style="text-shadow: rgba(0, 0, 0, 0.45) 0px 2px 30px;">Equipo para tu punto de venta.</h2>
        <a href="/sistema-pos" class="group inline-flex items-center gap-2 px-8 py-4 bg-white/[0.10] backdrop-blur-md text-white border border-white/30 rounded-full font-semibold text-base hover:bg-white/20 hover:border-white/50 transition-all duration-300">
          Más información
          <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>
  </section>

  <section class="w-full bg-white py-24 lg:py-32">
    <div class="max-w-[1280px] mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mb-12 lg:mb-16" data-reveal>
        <p class="text-[#5c606b] text-xs font-semibold uppercase tracking-[0.14em] mb-5" style="font-family: var(--font-brand);">Diseñado para todos los sectores</p>
        <h2 class="text-[#1a1d29] text-4xl md:text-5xl lg:text-[3.5rem] font-bold tracking-tight leading-[1.08]">Haz que tu negocio siga creciendo</h2>
      </div>
      <div class="flex flex-col md:flex-row gap-2.5 h-auto md:h-[640px]" data-sector-panels>
        {SECTOR_PANELS.map((sector, i) => (
          <a
            href={sector.href}
            data-sector-panel
            data-index={i}
            class="block relative rounded-2xl overflow-hidden cursor-pointer transition-all duration-[600ms] ease-[cubic-bezier(0.22,1,0.36,1)] bg-[#1a1d29]"
            style={i === 0 ? 'flex-grow:5; flex-basis:0px; min-height:400px;' : 'flex-grow:1; flex-basis:0px; min-height:92px;'}
          >
            <img src={`/images/index/${sector.image}`} alt={sector.title} class="absolute inset-0 w-full h-full object-cover" />
            <div data-sector-overlay class:list={['absolute inset-0 transition-opacity duration-500', i === 0 ? 'bg-gradient-to-t from-black/80 via-black/20 to-black/10' : 'bg-black/55']}></div>
            <div data-sector-content class:list={['absolute inset-0 flex p-6 md:p-8', i === 0 ? 'items-end' : 'items-end md:items-center md:justify-center']}>
              <div class="w-full">
                <h3 data-sector-title class:list={['text-white font-bold tracking-tight leading-none transition-all duration-500', i === 0 ? 'text-4xl lg:text-5xl mb-5' : 'text-2xl lg:text-3xl text-white/85 whitespace-nowrap md:[writing-mode:vertical-rl] md:mx-auto']}>{sector.title}</h3>
                <div data-sector-reveal class:list={['transition-all duration-500 overflow-hidden', i === 0 ? 'opacity-100 max-h-64' : 'opacity-0 max-h-0']}>
                  <div class="h-px w-full bg-white/25 mb-5"></div>
                  <p class="text-white text-xl lg:text-2xl font-semibold leading-snug mb-2 max-w-md">{sector.headline}</p>
                  <p class="text-white/70 text-sm leading-relaxed mb-5 max-w-md">{sector.text}</p>
                  <span class="inline-flex items-center gap-1.5 text-white font-semibold text-sm border-b border-white/60 pb-0.5 hover:gap-2.5 transition-all">
                    Obtén más información
                    <Icon name="arrow-right" class="w-4 h-4" />
                  </span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative w-full bg-[#0e2a6b] overflow-hidden">
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="max-w-lg py-16 md:py-24 min-h-[560px] md:min-h-[700px] flex flex-col justify-center">
        <div class="mb-10" data-reveal>
          <p class="text-[#8fb4ff] text-xs font-semibold uppercase tracking-[0.18em] mb-5">Características</p>
          <h2 class="text-white text-4xl md:text-5xl lg:text-[3.25rem] font-bold tracking-tight leading-[1.06] mb-5">Todo tu negocio,<br />con Qpaypro.</h2>
          <p class="text-white/70 text-lg leading-relaxed">En línea y en tu local: cobra, controla y crece con una sola plataforma.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-7">
          {FEATURES.map((f) => (
            <div class="flex items-start gap-3.5">
              <svg width="30" height="30" viewBox="0 0 28 28" fill="none" class="text-[#4ea6ff] mt-0.5 flex-shrink-0">
                <rect width="28" height="28" rx="8" fill="currentColor" opacity="0.10"></rect>
                <Fragment set:html={f.path} />
              </svg>
              <div>
                <h3 class="text-white text-base font-semibold mb-1 leading-snug">{f.title}</h3>
                <p class="text-white/60 text-sm leading-relaxed">{f.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <img src="/images/index/e640dd216114.webp" alt="App Qpaypro en un teléfono" class="absolute inset-0 z-0 w-full h-full object-cover object-right" />
    <div class="md:hidden absolute inset-0 z-[5] pointer-events-none" style="background: linear-gradient(rgba(14, 42, 107, 0.92) 0%, rgba(14, 42, 107, 0.8) 45%, rgba(14, 42, 107, 0.62) 100%);"></div>
    <div class="hidden md:block absolute inset-0 z-[5] pointer-events-none" style="background: linear-gradient(90deg, rgba(14, 42, 107, 0.85) 0%, rgba(14, 42, 107, 0.45) 38%, transparent 60%);"></div>
  </section>

  <section class="relative w-full bg-[#050506] py-20 lg:py-28 overflow-hidden">
    <style>
      @keyframes sec-loadtwo { 50% { transform: rotate(-80deg); } }
      @keyframes sec-spin { to { transform: rotate(360deg); } }
      .sec-cube { position: relative; width: 140px; height: 140px; display: flex; align-items: center; justify-content: center; }
      .sec-cube__color, .sec-cube__glow { position: absolute; width: 100%; height: 100%; border-radius: 28px; }
      .sec-cube__color { z-index: 1; filter: blur(6px); background: linear-gradient(135deg, #0047ba, #0f206c); animation: sec-loadtwo 2.5s ease-in-out infinite; }
      .sec-cube__glow { z-index: 2; display: flex; align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0.12); border: 2px solid rgba(255, 255, 255, 0.28); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
      .sec-orb { position: absolute; border-radius: 9999px; filter: blur(60px); opacity: 0.22; animation: sec-spin 16s linear infinite; }
      .sec-ring { position: absolute; inset: -2px; border-radius: 14px; background: conic-gradient(from 0deg, #0047ba, #0f206c, #0047ba); opacity: 0; transition: opacity 0.4s; animation: sec-spin 4s linear infinite; }
      .group:hover .sec-ring { opacity: 1; }
      @media (prefers-reduced-motion: reduce) {
        .sec-cube__color, .sec-orb, .sec-ring { animation: none !important; }
      }
    </style>
    <div class="sec-orb" style="width: 340px; height: 340px; top: -80px; right: -60px; background: linear-gradient(135deg, rgb(0, 71, 186), rgb(15, 32, 108));"></div>
    <div class="sec-orb" style="width: 300px; height: 300px; bottom: -120px; left: -80px; background: linear-gradient(135deg, rgb(15, 32, 108), rgb(0, 71, 186)); animation-direction: reverse;"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1fr_auto] items-center gap-10 lg:gap-14 mb-12 lg:mb-16">
        <div class="max-w-2xl" data-reveal>
          <div class="flex items-center gap-2.5 mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
            <p class="text-white/50 text-xs font-semibold uppercase tracking-[0.24em]" style="font-family: var(--font-brand);">Seguridad</p>
          </div>
          <h2 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold tracking-[-0.03em] leading-[1.03] mb-5">Seguridad.</h2>
          <p class="text-white/55 text-base lg:text-lg leading-relaxed font-light">Protección avanzada con validación, monitoreo de riesgo y cumplimiento PCI DSS para cuidar tu negocio y a tus clientes en todo momento.</p>
        </div>
        <div class="flex justify-center lg:justify-end">
          <div class="sec-cube" aria-hidden="true">
            <div class="sec-cube__color"></div>
            <div class="sec-cube__glow">
              <Icon name="shield-check" class="w-10 h-10 text-white" strokeWidth={1.5} />
            </div>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/[0.08] rounded-3xl overflow-hidden border border-white/[0.08]">
        {SECURITY_ITEMS.map((item) => (
          <div class="group relative bg-[#0a0a0c] p-5 lg:p-6 transition-colors duration-500 hover:bg-[#101014]">
            <span class="absolute top-5 right-6 text-white/20 text-xs group-hover:text-white/40 transition-colors" style="font-family: var(--font-brand);">{item.num}</span>
            <span class="relative inline-flex mb-4">
              <span class="sec-ring"></span>
              <span class="relative inline-flex w-9 h-9 rounded-xl bg-white/[0.06] border border-white/[0.10] items-center justify-center group-hover:bg-white group-hover:border-white transition-all duration-400 z-10">
                <Icon name={item.icon} class="w-5 h-5 text-white group-hover:text-black transition-colors duration-400" strokeWidth={1.75} />
              </span>
            </span>
            <h3 class="text-white text-[15px] font-semibold mb-1.5 leading-snug">{item.title}</h3>
            <p class="text-white/50 text-[13px] leading-relaxed font-light mb-4">{item.text}</p>
            <span class="inline-block text-white/40 text-[11px] font-medium uppercase tracking-[0.12em] px-2.5 py-1 rounded-md border border-white/[0.12]" style="font-family: var(--font-brand);">{item.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FeeCalculator />

  <section class="w-full bg-[#f6f7f9] py-24 lg:py-32">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mb-14 lg:mb-20" data-reveal>
        <p class="text-[#5c606b] text-xs font-semibold uppercase tracking-[0.14em] mb-5">Plataforma Qpaypro</p>
        <h2 class="text-[#1a1d29] text-4xl md:text-5xl lg:text-[3.5rem] font-bold tracking-tight leading-[1.08]">Administra todo desde un solo lugar</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div class="divide-y divide-[#dfe1e6]" data-platform-list>
          {PLATFORM_ITEMS.map((item, i) => (
            <div data-platform-item data-index={i}>
              <button type="button" data-platform-trigger class="w-full flex items-center justify-between py-6 text-left group">
                <span data-platform-label class:list={['text-xl lg:text-2xl font-semibold transition-colors', i === 0 ? 'text-[#1a1d29]' : 'text-[#9094a0] group-hover:text-[#1a1d29]']}>{item.title}</span>
                <span data-platform-icon>
                  <Icon name={i === 0 ? 'minus' : 'plus'} class:list={['w-5 h-5 flex-shrink-0 transition-colors', i === 0 ? 'text-[#1a1d29]' : 'text-[#9094a0] group-hover:text-[#1a1d29]']} />
                </span>
              </button>
              <div data-platform-panel class:list={['overflow-hidden transition-all duration-500 ease-out', i === 0 ? 'max-h-64 opacity-100 pb-7' : 'max-h-0 opacity-0']}>
                <p class="text-[#5c606b] text-base leading-relaxed mb-4 max-w-md">{item.text}</p>
                <a href="/sistema-pos" class="inline-flex items-center gap-1.5 text-[#0047ba] font-semibold text-sm hover:gap-2.5 transition-all">
                  Más información
                  <Icon name="arrow-right" class="w-4 h-4" />
                </a>
                <div class="lg:hidden mt-6 rounded-3xl overflow-hidden aspect-[4/3]">
                  <img src={`/images/index/${item.image}`} alt={item.title} class="w-full h-full object-cover" />
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="hidden lg:block sticky top-32">
          <div class="relative rounded-3xl overflow-hidden aspect-[4/5] bg-white" data-platform-images>
            {PLATFORM_ITEMS.map((item, i) => (
              <img src={`/images/index/${item.image}`} alt={item.title} class:list={['absolute inset-0 w-full h-full transition-opacity duration-500 object-cover', i === 0 ? 'opacity-100' : 'opacity-0']} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative w-full bg-[#050506] py-28 lg:py-40 overflow-hidden">
    <style>
      @keyframes cta-loadtwo { 50% { transform: rotate(-80deg); } }
      @keyframes cta-spin { to { transform: rotate(360deg); } }
      .cta-orb { position: absolute; border-radius: 9999px; filter: blur(70px); opacity: 0.4; animation: cta-spin 18s linear infinite; }
      @media (prefers-reduced-motion: reduce) { .cta-orb { animation: none !important; } }
    </style>
    <div class="absolute inset-0 opacity-[0.06] pointer-events-none" style="background-image: linear-gradient(rgba(255, 255, 255, 0.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.6) 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div class="cta-orb" style="width: 460px; height: 460px; top: -120px; left: 50%; margin-left: -230px; background: linear-gradient(135deg, rgb(0, 71, 186), rgb(15, 32, 108));"></div>
    <div class="cta-orb" style="width: 320px; height: 320px; bottom: -100px; right: -40px; background: linear-gradient(135deg, rgb(15, 32, 108), rgb(0, 71, 186)); animation-direction: reverse;"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center" data-reveal>
        <div class="flex items-center justify-center gap-2.5 mb-7">
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
          <p class="text-white/50 text-xs font-semibold uppercase tracking-[0.24em]" style="font-family: var(--font-brand);">Empieza hoy</p>
        </div>
        <h2 class="text-white text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.03em] leading-[1.03] mb-6">Da el siguiente paso.</h2>
        <p class="text-white/55 text-xl leading-relaxed font-light mb-12 max-w-xl mx-auto">Únete a los negocios que ya cobran, operan y crecen con Qpaypro.</p>
        <div class="flex items-center justify-center gap-4 flex-wrap">
          <a href="/precios" class="group px-8 py-4 bg-white text-[#050506] rounded-full font-semibold text-base hover:bg-white/90 transition-colors duration-300 flex items-center gap-2">
            Crear cuenta gratis
            <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="/contacto#ventas" class="px-8 py-4 bg-white/[0.06] backdrop-blur-md border border-white/25 text-white rounded-full font-semibold text-base hover:bg-white/[0.12] hover:border-white/40 transition-all duration-300">Hablar con ventas</a>
        </div>
      </div>
    </div>
  </section>

  <section class="w-full bg-[#f5f6f8] py-24 lg:py-32">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14 lg:mb-16" data-reveal>
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Testimonios</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] leading-[1.04]">Negocios que ya crecen con Qpaypro</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {TESTIMONIALS.map((t) => (
          <div class="flex flex-col rounded-3xl bg-white border border-black/[0.06] shadow-[0_10px_30px_-18px_rgba(15,32,108,0.25)] p-7">
            <Icon name="quote" class="w-7 h-7 text-[#0047ba]/25 mb-4" strokeWidth={1.6} />
            <p class="text-[#3a3d47] text-[15px] leading-relaxed font-light flex-1 mb-6">{t.text}</p>
            <div class="flex items-center gap-3">
              <img src={`/images/index/${t.image}`} alt={t.name} class="w-11 h-11 rounded-full object-cover flex-shrink-0" />
              <div>
                <div class="text-[#1a1d29] font-semibold text-sm">{t.name}</div>
                <div class="text-[#8a8f9a] text-xs">{t.company}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-sector-panel]'));

    function activatePanel(panel: HTMLElement) {
        panels.forEach((p) => {
          const active = p === panel;
          p.style.flexGrow = active ? '5' : '1';
          p.style.minHeight = active ? '400px' : '92px';

          const overlay = p.querySelector<HTMLElement>('[data-sector-overlay]');
          overlay?.classList.remove('bg-gradient-to-t', 'from-black/80', 'via-black/20', 'to-black/10', 'bg-black/55');
          overlay?.classList.add(...(active ? ['bg-gradient-to-t', 'from-black/80', 'via-black/20', 'to-black/10'] : ['bg-black/55']));

          const content = p.querySelector<HTMLElement>('[data-sector-content]');
          content?.classList.remove('items-end', 'md:items-center', 'md:justify-center');
          content?.classList.add(...(active ? ['items-end'] : ['items-end', 'md:items-center', 'md:justify-center']));

          const title = p.querySelector<HTMLElement>('[data-sector-title]');
          title?.classList.remove('text-4xl', 'lg:text-5xl', 'mb-5', 'text-2xl', 'lg:text-3xl', 'text-white/85', 'whitespace-nowrap', 'md:[writing-mode:vertical-rl]', 'md:mx-auto');
          title?.classList.add(...(active ? ['text-4xl', 'lg:text-5xl', 'mb-5'] : ['text-2xl', 'lg:text-3xl', 'text-white/85', 'whitespace-nowrap', 'md:[writing-mode:vertical-rl]', 'md:mx-auto']));

          const reveal = p.querySelector<HTMLElement>('[data-sector-reveal]');
          reveal?.classList.remove('opacity-100', 'max-h-64', 'opacity-0', 'max-h-0');
          reveal?.classList.add(...(active ? ['opacity-100', 'max-h-64'] : ['opacity-0', 'max-h-0']));
        });
    }

    // Each card is a real link to its sector page. On pointer devices the
    // hover already expands the card, so a click just follows the link.
    // On touch (no hover) we keep the original behaviour: the first tap
    // expands the card so its text can be read, and a second tap navigates.
    const canHover = window.matchMedia('(hover: hover)').matches;

    panels.forEach((panel) => {
      if (canHover) {
        // Pointer devices: hover expands, and a click just follows the link.
        panel.addEventListener('mouseenter', () => activatePanel(panel));
        return;
      }

      // Touch: bind expansion to the tap itself. We must not listen for
      // mouseenter here — the browser synthesises one right before the click,
      // which would mark the card as already expanded and let the first tap
      // navigate away before its text was ever shown.
      panel.addEventListener('click', (e) => {
        if (panel.dataset.expanded === 'true') return;
        e.preventDefault();
        panels.forEach((p) => delete p.dataset.expanded);
        panel.dataset.expanded = 'true';
        activatePanel(panel);
      });
    });

    if (!canHover && panels[0]) panels[0].dataset.expanded = 'true';

    const platformItems = Array.from(document.querySelectorAll<HTMLElement>('[data-platform-item]'));
    const platformImages = Array.from(document.querySelectorAll<HTMLImageElement>('[data-platform-images] img'));
    platformItems.forEach((item, index) => {
      const trigger = item.querySelector<HTMLElement>('[data-platform-trigger]');
      trigger?.addEventListener('click', () => {
        platformItems.forEach((it, i) => {
          const active = i === index;
          const label = it.querySelector<HTMLElement>('[data-platform-label]');
          label?.classList.remove('text-[#1a1d29]', 'text-[#9094a0]', 'group-hover:text-[#1a1d29]');
          label?.classList.add(...(active ? ['text-[#1a1d29]'] : ['text-[#9094a0]', 'group-hover:text-[#1a1d29]']));

          const iconSlot = it.querySelector<HTMLElement>('[data-platform-icon]');
          if (iconSlot) {
            iconSlot.innerHTML = '';
            const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
            svg.setAttribute('width', '24');
            svg.setAttribute('height', '24');
            svg.setAttribute('viewBox', '0 0 24 24');
            svg.setAttribute('fill', 'none');
            svg.setAttribute('stroke', 'currentColor');
            svg.setAttribute('stroke-width', '2');
            svg.setAttribute('stroke-linecap', 'round');
            svg.setAttribute('stroke-linejoin', 'round');
            svg.setAttribute('class', `lucide w-5 h-5 flex-shrink-0 transition-colors ${active ? 'text-[#1a1d29]' : 'text-[#9094a0] group-hover:text-[#1a1d29]'}`);
            svg.innerHTML = active
              ? '<path d="M5 12h14"></path>'
              : '<path d="M5 12h14"></path><path d="M12 5v14"></path>';
            iconSlot.appendChild(svg);
          }

          const panel = it.querySelector<HTMLElement>('[data-platform-panel]');
          panel?.classList.remove('max-h-64', 'opacity-100', 'pb-7', 'max-h-0', 'opacity-0');
          panel?.classList.add(...(active ? ['max-h-64', 'opacity-100', 'pb-7'] : ['max-h-0', 'opacity-0']));
        });

        platformImages.forEach((img, i) => {
          img.classList.remove('opacity-100', 'opacity-0');
          img.classList.add(i === index ? 'opacity-100' : 'opacity-0');
        });
      });
    });
  </script>
</MainLayout>
