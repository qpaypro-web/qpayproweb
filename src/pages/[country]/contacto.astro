---
import MainLayout from '../../layouts/MainLayout.astro';
import Icon from '../../components/Icon.astro';
import { countryPaths, getCountry, COUNTRY_LABELS, withCountry } from '../../lib/country';

// Los valores que acepta el formulario. La función de /api/lead vuelve a
// validarlos del lado del servidor: lo que llega del navegador no es confiable
// y Zoho rechaza cualquier valor fuera de lista con INVALID_DATA.
const COUNTRY_OPTIONS = ['Guatemala', 'El Salvador'];

// El nombre del modelo cambia por país (POS Cute en Guatemala, POS A920 en El
// Salvador), pero en el formulario la opción es la misma en los dos: al cliente
// se le pregunta por el producto, no por el aparato.
const SERVICE_OPTIONS = ['Pagos con tarjeta', 'Tienda en línea', 'Punto de venta', 'Terminal POS'];

const MESSAGE_MAX = 200;

const SUPPORT_LINKS = [
  { href: 'https://api.whatsapp.com/send/?phone=50247856011', icon: 'message-circle', title: 'WhatsApp', subtitle: 'Ayuda más rápida' },
  { href: 'mailto:soporte@qpaypro.com', icon: 'mail', title: 'Ticket', subtitle: 'soporte@qpaypro.com' },
  { href: 'https://soporte.qpaypro.com', icon: 'life-buoy', title: 'Autoayuda', subtitle: 'soporte.qpaypro.com' },
];

const OFFICES = [
  {
    country: 'Guatemala',
    city: 'Santa Catarina Pinula',
    address: 'Km 15.8 Carretera a El Salvador, Edificio Torre Castaño, Santa Catarina Pinula, Guatemala.',
    phone: '+(502) 2355-6000',
    hours: 'Lunes a Viernes · 8:00 a 17:00 hrs',
    flag: 'gt',
  },
  {
    country: 'El Salvador',
    city: 'San Salvador',
    address: 'Calle La Mascota, No. 533, Colonia San Benito, Oficinas Stofficenter, Distrito de San Salvador.',
    phone: '+(503) 2208-2300',
    hours: 'Lunes a Viernes · 8:00 a 17:00 hrs (previa cita)',
    flag: 'sv',
  },
];

export const getStaticPaths = countryPaths;
const country = Astro.params.country!;
const c = getCountry(country);

// La ruta ya dice en qué país está el visitante, así que el select llega
// marcado. Se deja editable: el país de la ruta es una suposición, no un dato.
const countryLabel = COUNTRY_LABELS[country as keyof typeof COUNTRY_LABELS];
const privacyHref = withCountry(country, '/politicas-de-privacidad');

// Pública por diseño: Turnstile valida el par sitekey/dominio y el secreto que
// verifica el token vive solo en la Function.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<MainLayout
  title="Contacto y soporte | Qpaypro"
  description="Contáctanos para ventas y soporte. Oficinas en Guatemala y El Salvador. Cobra con tarjeta, links de pago y tienda en línea con Qpaypro."
  headerTheme="onDark"
>
  <section class="relative w-full flex items-center pt-40 pb-28 lg:pt-48 lg:pb-36 min-h-screen overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/contacto/23175c84ee63.webp');"></div>
    <div class="absolute inset-0 bg-black/[0.55]"></div>
    <div class="absolute inset-0" style="background: linear-gradient(rgba(5, 5, 6, 0.35) 0%, rgba(5, 5, 6, 0.1) 45%, rgba(5, 5, 6, 0.45) 100%);"></div>
    <div class="relative z-10 w-full max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-10 lg:gap-0 divide-y lg:divide-y-0 lg:divide-x divide-white/25">
        <div class="lg:pr-14 flex flex-col items-center text-center">
          <h1 class="text-white text-3xl lg:text-4xl font-semibold tracking-[-0.03em] mb-4" style="text-shadow: rgba(0, 0, 0, 0.4) 0px 2px 24px;">Soporte</h1>
          <p class="text-white/75 text-lg font-light mb-1">Obtén asistencia en cualquiera de nuestros canales</p>
          <p class="text-white font-medium mb-8">Lunes a Domingo de 7:00 a 20:00 hrs</p>
          <div class="flex flex-col sm:flex-row gap-4 w-full">
            {SUPPORT_LINKS.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer" class="group flex flex-1 min-w-0 flex-col items-center gap-2.5">
                <Icon name={link.icon} class="w-5 h-5 text-white/90 group-hover:text-white transition-colors duration-300" strokeWidth={1.8} />
                <span class="w-full text-center rounded-full bg-white/[0.13] border border-white/25 backdrop-blur-md px-3 py-2.5 group-hover:bg-white/[0.20] group-hover:border-white/40 transition-all duration-300">
                  <span class="block text-white font-semibold text-[13px] leading-tight">{link.title}</span>
                  <span class="block text-white/70 text-[11px] leading-snug whitespace-nowrap">{link.subtitle}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
        <div class="lg:pl-14 flex flex-col items-center justify-center text-center">
          <h2 class="text-white text-3xl lg:text-4xl font-semibold tracking-[-0.03em] mb-4" style="text-shadow: rgba(0, 0, 0, 0.4) 0px 2px 24px;">Contactar Ventas</h2>
          <p class="text-white/75 text-lg font-light mb-8 max-w-sm">Cuéntanos de tu negocio y un asesor te contactará.</p>
          <a href="#ventas" class="group inline-flex items-center gap-2 px-8 py-4 text-white font-semibold text-base rounded-full bg-white/[0.07] border border-white/15 backdrop-blur-md hover:bg-white/[0.13] hover:border-white/30 transition-all duration-300">
            Contactar a ventas
            <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="ventas" class="w-full bg-[#f5f6f8] py-24 lg:py-32 scroll-mt-24">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Contactar ventas</p>
        <h2 class="text-[#1a1d29] text-4xl md:text-5xl font-semibold tracking-[-0.03em] leading-[1.03] mb-5">Hablemos de tu negocio</h2>
        <p class="text-[#6b7280] text-lg font-light">Cuéntanos de tu negocio y un asesor te contactará para ayudarte a vender más.</p>
      </div>
      <div class="bg-white rounded-[28px] border border-black/[0.06] shadow-[0_40px_90px_-40px_rgba(15,32,108,0.30)] p-7 lg:p-10">
        <div data-contact-success class="hidden text-center py-12">
          <Icon name="circle-check" class="w-14 h-14 text-[#0a9d5a] mx-auto mb-5" strokeWidth={1.6} />
          <h3 class="text-[#1a1d29] text-2xl font-semibold mb-2">¡Gracias por escribirnos!</h3>
          <p class="text-[#6b7280] font-light">Un asesor de Qpaypro te contactará muy pronto.</p>
        </div>
        <form data-contact-form class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="cf-first-name" class="block text-[#3a3d47] text-sm font-medium mb-2">Nombre *</label>
            <input id="cf-first-name" name="first_name" autocomplete="given-name" required class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-[#1a1d29] placeholder-[#9aa0aa] text-[15px] focus:outline-none focus:border-[#0047ba] focus:ring-2 focus:ring-[#0047ba]/15 transition" placeholder="Tu nombre" />
          </div>
          <div>
            <label for="cf-last-name" class="block text-[#3a3d47] text-sm font-medium mb-2">Apellido *</label>
            <input id="cf-last-name" name="last_name" autocomplete="family-name" required class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-[#1a1d29] placeholder-[#9aa0aa] text-[15px] focus:outline-none focus:border-[#0047ba] focus:ring-2 focus:ring-[#0047ba]/15 transition" placeholder="Tu apellido" />
          </div>
          <div class="sm:col-span-2">
            <label for="cf-company" class="block text-[#3a3d47] text-sm font-medium mb-2">Empresa *</label>
            <input id="cf-company" name="company" autocomplete="organization" required class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-[#1a1d29] placeholder-[#9aa0aa] text-[15px] focus:outline-none focus:border-[#0047ba] focus:ring-2 focus:ring-[#0047ba]/15 transition" placeholder="Nombre de tu empresa" />
          </div>
          <div>
            <label for="cf-email" class="block text-[#3a3d47] text-sm font-medium mb-2">Email *</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-[#1a1d29] placeholder-[#9aa0aa] text-[15px] focus:outline-none focus:border-[#0047ba] focus:ring-2 focus:ring-[#0047ba]/15 transition" placeholder="tucorreo@ejemplo.com" />
          </div>
          <div>
            <label for="cf-phone" class="block text-[#3a3d47] text-sm font-medium mb-2">Teléfono *</label>
            <input id="cf-phone" name="phone" type="tel" autocomplete="tel" required class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-[#1a1d29] placeholder-[#9aa0aa] text-[15px] focus:outline-none focus:border-[#0047ba] focus:ring-2 focus:ring-[#0047ba]/15 transition" placeholder="+502 0000-0000" />
          </div>
          <div class="sm:col-span-2">
            <label for="cf-country" class="block text-[#3a3d47] text-sm font-medium mb-2">País *</label>
            <select id="cf-country" name="country" autocomplete="country-name" required class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-[#1a1d29] placeholder-[#9aa0aa] text-[15px] focus:outline-none focus:border-[#0047ba] focus:ring-2 focus:ring-[#0047ba]/15 transition">
              <option value="" disabled selected={!countryLabel}>Selecciona una opción</option>
              {COUNTRY_OPTIONS.map((option) => (
                <option value={option} selected={option === countryLabel}>{option}</option>
              ))}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="cf-product" class="block text-[#3a3d47] text-sm font-medium mb-2">¿Qué producto o servicio vendes? *</label>
            <input id="cf-product" name="product" required class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-[#1a1d29] placeholder-[#9aa0aa] text-[15px] focus:outline-none focus:border-[#0047ba] focus:ring-2 focus:ring-[#0047ba]/15 transition" placeholder="Describe brevemente tu producto o servicio" />
          </div>
          <div class="sm:col-span-2">
            <label for="cf-service" class="block text-[#3a3d47] text-sm font-medium mb-2">¿Qué servicio te interesa? *</label>
            <select id="cf-service" name="service" required class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-[#1a1d29] placeholder-[#9aa0aa] text-[15px] focus:outline-none focus:border-[#0047ba] focus:ring-2 focus:ring-[#0047ba]/15 transition">
              <option value="" disabled selected>Selecciona una opción</option>
              {SERVICE_OPTIONS.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="cf-message" class="block text-[#3a3d47] text-sm font-medium mb-2">¿Cómo podemos ayudarte? (Opcional)</label>
            <textarea id="cf-message" name="message" rows="4" maxlength={MESSAGE_MAX} class="w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-[#1a1d29] placeholder-[#9aa0aa] text-[15px] focus:outline-none focus:border-[#0047ba] focus:ring-2 focus:ring-[#0047ba]/15 transition resize-none" placeholder="Cuéntanos más sobre lo que necesitas"></textarea>
          </div>

          {/* Trampa para bots. Fuera de la vista pero sin display:none, que es
              lo que muchos bots detectan; oculto también para lectores de
              pantalla y fuera del orden de tabulación. */}
          <div aria-hidden="true" class="sr-only">
            <label for="cf-website">No llenar este campo</label>
            <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          {/* Turnstile solo aparece si hay sitekey configurada. Sin ella el
              formulario sigue funcionando —con honeypot, validación de servidor
              y límite por IP— para no dejarlo inutilizable mientras se
              configuran las llaves. */}
          {turnstileSiteKey && (
            <div class="sm:col-span-2 flex justify-center">
              <div data-turnstile data-sitekey={turnstileSiteKey} class="min-h-[65px]"></div>
            </div>
          )}

          {/* El error no reemplaza al formulario: se anuncia arriba del botón y
              deja intacto lo que la persona ya escribió, para que reintentar no
              signifique volver a llenarlo todo. */}
          <div data-contact-error role="alert" class="hidden sm:col-span-2 rounded-xl border border-[#c0392b]/25 bg-[#c0392b]/[0.06] px-4 py-3.5">
            <p class="text-[#a5281c] text-sm font-medium" data-contact-error-text></p>
          </div>

          <div class="sm:col-span-2 mt-2 flex flex-col items-center gap-4">
            <button
              type="submit"
              disabled={Boolean(turnstileSiteKey)}
              data-submit-btn
              class:list={[
                'group w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full font-semibold text-base transition-all duration-300 text-white',
                turnstileSiteKey ? 'bg-[#c8cbd2] cursor-not-allowed' : 'bg-[#0047ba] hover:bg-[#0f206c]',
              ]}
            >
              <span data-submit-label>Enviar mensaje</span>
              <Icon name="send" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" data-submit-icon />
              <span data-submit-spinner class="hidden w-4 h-4 rounded-full border-2 border-white/40 border-t-white animate-spin"></span>
            </button>
            <p class="text-[#8a8f9a] text-xs text-center max-w-md leading-relaxed">
              Al enviar aceptas que Qpaypro trate tus datos para contactarte. Consulta nuestra
              <a href={privacyHref} class="text-[#0047ba] hover:underline">política de privacidad</a>.
            </p>
          </div>
          <p data-contact-status role="status" aria-live="polite" class="sr-only"></p>
        </form>
      </div>
    </div>
  </section>

  <section class="w-full bg-[#f5f6f8] py-24 lg:py-32">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14 lg:mb-16">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Estamos para ayudarte</p>
        <h2 class="text-[#1a1d29] text-4xl md:text-5xl font-semibold tracking-[-0.03em] leading-[1.03]">Nuestras oficinas</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        {OFFICES.map((office) => (
          <div class="group relative overflow-hidden rounded-[28px] border border-black/[0.06] bg-white p-8 lg:p-10 shadow-[0_20px_50px_-30px_rgba(15,32,108,0.25)] transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[0_40px_80px_-38px_rgba(15,32,108,0.32)]">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#0f206c] via-[#0047ba] to-[#0097ce]"></div>
            <div class="flex items-center gap-4 mb-8">
              <span class="w-14 h-10 rounded-lg overflow-hidden ring-1 ring-black/10 shadow-sm flex-shrink-0">
                {office.flag === 'gt' ? (
                  <svg viewBox="0 0 30 20" class="w-full h-full">
                    <rect width="30" height="20" fill="#4997D0" />
                    <rect x="10" width="10" height="20" fill="#fff" />
                    <circle cx="15" cy="10" r="2.2" fill="none" stroke="#3a7d3a" stroke-width="0.5" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 30 20" class="w-full h-full">
                    <rect width="30" height="20" fill="#0F47AF" />
                    <rect y="6.667" width="30" height="6.667" fill="#fff" />
                    <circle cx="15" cy="10" r="2" fill="none" stroke="#d4a017" stroke-width="0.5" />
                  </svg>
                )}
              </span>
              <div>
                <h3 class="text-[#1a1d29] text-2xl font-semibold tracking-tight leading-none mb-1">{office.country}</h3>
                <span class="text-[#8a8f9a] text-sm">{office.city}</span>
              </div>
            </div>
            <div class="space-y-5 mb-8">
              <div class="flex items-start gap-3.5">
                <span class="inline-flex w-9 h-9 rounded-lg bg-[#0047ba]/[0.08] items-center justify-center flex-shrink-0">
                  <Icon name="map-pin" class="w-4 h-4 text-[#0047ba]" strokeWidth={1.9} />
                </span>
                <div>
                  <div class="text-[#8a8f9a] text-xs font-semibold uppercase tracking-wider mb-0.5">Dirección</div>
                  <div class="text-[#3a3d47] text-[15px] leading-relaxed">{office.address}</div>
                </div>
              </div>
              <div class="flex items-start gap-3.5">
                <span class="inline-flex w-9 h-9 rounded-lg bg-[#0047ba]/[0.08] items-center justify-center flex-shrink-0">
                  <Icon name="phone" class="w-4 h-4 text-[#0047ba]" strokeWidth={1.9} />
                </span>
                <div>
                  <div class="text-[#8a8f9a] text-xs font-semibold uppercase tracking-wider mb-0.5">Teléfono</div>
                  <div class="text-[#3a3d47] text-[15px] leading-relaxed">{office.phone}</div>
                </div>
              </div>
              <div class="flex items-start gap-3.5">
                <span class="inline-flex w-9 h-9 rounded-lg bg-[#0047ba]/[0.08] items-center justify-center flex-shrink-0">
                  <Icon name="clock" class="w-4 h-4 text-[#0047ba]" strokeWidth={1.9} />
                </span>
                <div>
                  <div class="text-[#8a8f9a] text-xs font-semibold uppercase tracking-wider mb-0.5">Horario</div>
                  <div class="text-[#3a3d47] text-[15px] leading-relaxed">{office.hours}</div>
                </div>
              </div>
            </div>
            <a href="https://api.whatsapp.com/send/?phone=50247856011" target="_blank" rel="noreferrer" class="group/btn inline-flex items-center gap-2 px-6 py-3 bg-[#050506] text-white rounded-full font-semibold text-sm hover:bg-[#0047ba] transition-colors duration-300">
              <Icon name="message-circle" class="w-4 h-4" />
              Escríbenos por WhatsApp
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>

  <script>
    interface Turnstile {
      render(el: HTMLElement, opts: Record<string, unknown>): string;
      reset(id?: string): void;
    }

    declare global {
      interface Window {
        turnstile?: Turnstile;
      }
    }

    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const submitBtn = document.querySelector<HTMLButtonElement>('[data-submit-btn]');
    const submitLabel = document.querySelector<HTMLElement>('[data-submit-label]');
    const submitIcon = document.querySelector<SVGElement>('[data-submit-icon]');
    const submitSpinner = document.querySelector<HTMLElement>('[data-submit-spinner]');
    const successPanel = document.querySelector<HTMLElement>('[data-contact-success]');
    const errorPanel = document.querySelector<HTMLElement>('[data-contact-error]');
    const errorText = document.querySelector<HTMLElement>('[data-contact-error-text]');
    const statusLine = document.querySelector<HTMLElement>('[data-contact-status]');
    const turnstileHost = document.querySelector<HTMLElement>('[data-turnstile]');

    const ENABLED = ['bg-[#0047ba]', 'text-white', 'hover:bg-[#0f206c]'];
    const DISABLED = ['bg-[#c8cbd2]', 'text-white', 'cursor-not-allowed'];

    const GENERIC_ERROR = 'No pudimos enviar tu mensaje. Inténtalo de nuevo o escríbenos por WhatsApp.';

    let captchaToken = '';
    let widgetId: string | undefined;
    let sending = false;

    function setEnabled(enabled: boolean) {
      if (!submitBtn) return;
      submitBtn.disabled = !enabled;
      submitBtn.classList.remove(...ENABLED, ...DISABLED);
      submitBtn.classList.add(...(enabled ? ENABLED : DISABLED));
    }

    function showError(message: string) {
      if (errorText) errorText.textContent = message;
      errorPanel?.classList.remove('hidden');
      if (statusLine) statusLine.textContent = message;
    }

    function clearError() {
      errorPanel?.classList.add('hidden');
      if (statusLine) statusLine.textContent = '';
    }

    function setSending(value: boolean) {
      sending = value;
      if (submitLabel) submitLabel.textContent = value ? 'Enviando…' : 'Enviar mensaje';
      submitIcon?.classList.toggle('hidden', value);
      submitSpinner?.classList.toggle('hidden', !value);
      // Durante el envío el botón se bloquea aunque haya token, para que un
      // doble clic no cree dos leads.
      setEnabled(!value && (!captchaEnabled || Boolean(captchaToken)));
      if (value && statusLine) statusLine.textContent = 'Enviando tu mensaje…';
    }

    // Turnstile carga de forma asíncrona y este módulo puede ejecutarse antes o
    // después, así que se espera al objeto global en vez de depender del orden.
    function whenTurnstileReady(callback: (api: Turnstile) => void) {
      if (window.turnstile) return callback(window.turnstile);
      let waited = 0;
      const timer = window.setInterval(() => {
        if (window.turnstile) {
          window.clearInterval(timer);
          callback(window.turnstile);
        } else if ((waited += 150) > 15000) {
          window.clearInterval(timer);
          showError('No se pudo cargar la verificación de seguridad. Recarga la página.');
        }
      }, 150);
    }

    const sitekey = turnstileHost?.dataset.sitekey ?? '';
    // Sin sitekey no hay captcha y el formulario se usa igual. Lo que queda
    // protegiéndolo es el honeypot, la validación del servidor y el límite por
    // IP; el captcha se enciende solo en cuanto la variable exista en el build.
    const captchaEnabled = Boolean(turnstileHost && sitekey);

    if (!turnstileHost || !sitekey) {
      console.warn('[contacto] Sin PUBLIC_TURNSTILE_SITE_KEY: el formulario funciona sin captcha.');
      setEnabled(true);
    } else {
      whenTurnstileReady((api) => {
        widgetId = api.render(turnstileHost, {
          sitekey,
          language: 'es',
          // Sin clearError() aquí: tras un envío fallido se resetea el widget y
          // este callback vuelve a dispararse, así que limpiar el error borraría
          // el mensaje justo después de mostrarlo. El error se limpia al
          // reintentar el envío, no al llegar un token nuevo.
          callback: (token: string) => {
            captchaToken = token;
            setEnabled(!sending);
          },
          'expired-callback': () => {
            captchaToken = '';
            setEnabled(false);
          },
          'error-callback': () => {
            captchaToken = '';
            setEnabled(false);
            showError('No se pudo completar la verificación de seguridad. Inténtalo de nuevo.');
          },
        });
      });
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending || !form.reportValidity()) return;
      if (captchaEnabled && !captchaToken) {
        showError('Completa la verificación de seguridad antes de enviar.');
        return;
      }

      clearError();
      setSending(true);

      const data = Object.fromEntries(new FormData(form).entries());
      // Turnstile inyecta su propio input en el formulario; el token se manda
      // aparte y explícito, así que este sobra en el payload.
      delete data['cf-turnstile-response'];

      try {
        const response = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, turnstileToken: captchaToken }),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.ok) {
          throw new Error(typeof result.error === 'string' ? result.error : GENERIC_ERROR);
        }

        form.classList.add('hidden');
        successPanel?.classList.remove('hidden');
        if (statusLine) statusLine.textContent = 'Mensaje enviado.';
      } catch (error) {
        // El token de Turnstile es de un solo uso: si el envío falló hay que
        // pedir uno nuevo o el reintento se rechaza siempre. Sin captcha no hay
        // nada que renovar y el botón vuelve a quedar disponible enseguida.
        captchaToken = '';
        if (widgetId !== undefined) window.turnstile?.reset(widgetId);
        setSending(false);
        setEnabled(!captchaEnabled);
        showError(error instanceof Error ? error.message : GENERIC_ERROR);
      }
    });
  </script>
</MainLayout>
