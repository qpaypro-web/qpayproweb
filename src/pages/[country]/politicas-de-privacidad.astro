---
import MainLayout from '../../layouts/MainLayout.astro';
import LegalContent from '../../components/LegalContent.astro';
import blocks from '../../data/legal-privacidad.json';
import { countryPaths, getCountry } from '../../lib/country';

export const getStaticPaths = countryPaths;
const country = Astro.params.country!;
const c = getCountry(country);
---

<MainLayout
  title="Políticas de Privacidad | Qpaypro"
  description="Condiciones de uso, propiedad intelectual y protección de datos personales del sitio web de Qpaypro."
  headerTheme="onLight"
>
  <LegalContent blocks={blocks} eyebrow="Legal" />
</MainLayout>
