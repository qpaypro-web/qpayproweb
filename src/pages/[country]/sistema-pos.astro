---
import MainLayout from '../../layouts/MainLayout.astro';
import Icon from '../../components/Icon.astro';
import ConnectedPlatformDiagram from '../../components/ConnectedPlatformDiagram.astro';
import { countryPaths, getCountry, type CountryCode } from '../../lib/country';
import { ID_ORGANIZACION, preguntasFrecuentes, servicio, urlAbsoluta } from '../../lib/schema';

const PIECES = [
  { src: '/images/sistema-pos/38c08d7b58b2.webp', desktop: { left: '13.667%', top: '58.074%', width: '2.625%' }, mobile: { left: '13.667%', top: '64.974%', width: '2.625%' }, delay: '0.35s' },
  { src: '/images/sistema-pos/e6bddd1eb37e.webp', desktop: { left: '17.958%', top: '31.63%', width: '8.25%' }, mobile: { left: '17.958%', top: '46.477%', width: '8.25%' }, delay: '0.63s' },
  { src: '/images/sistema-pos/8624cb394df6.webp', desktop: { left: '28.208%', top: '40.074%', width: '8.542%' }, mobile: { left: '28.208%', top: '52.383%', width: '8.542%' }, delay: '0.91s' },
  { src: '/images/sistema-pos/bd4fff269ba6.webp', desktop: { left: '34.5%', top: '74.296%', width: '31.083%' }, mobile: { left: '34.5%', top: '76.321%', width: '31.083%' }, delay: '1.19s' },
  { src: '/images/sistema-pos/b659d2c7fb02.webp', desktop: { left: '38.625%', top: '13.333%', width: '33.625%' }, mobile: { left: '38.625%', top: '33.679%', width: '33.625%' }, delay: '1.47s' },
  { src: '/images/sistema-pos/dc10e3ff99ab.webp', desktop: { left: '73.125%', top: '37.556%', width: '14.583%' }, mobile: { left: '73.125%', top: '50.622%', width: '14.583%' }, delay: '1.75s' },
];

// Sin marcas ni modelos: el equipo puede variar según disponibilidad y lo que
// se le promete al cliente es la capacidad, no una referencia concreta.
const HARDWARE_PIECES = [
  { title: 'Terminal POS', text: 'Pantalla táctil con el software Qpaypro sobre stand de aluminio, con bloqueo antirrobo y carga por contacto.' },
  { title: 'Escáner inalámbrico', text: 'Lee códigos 1D y 2D al instante, hasta 30-50 m de alcance, con receptor USB incluido.' },
  { title: 'Impresora de recibos', text: 'Térmica de alta velocidad y eficiencia.' },
  { title: 'Cajón de efectivo', text: 'De acero laminado en frío, con 5 ranuras para billetes y 8 para monedas.' },
];

const SPECS = [
  { label: 'Terminal', value: 'Pantalla táctil con software Qpaypro sobre stand universal de aluminio · bloqueo antirrobo · carga por contacto · 149.5 × 133 × 225 mm' },
  { label: 'Escáner', value: 'Códigos 1D y 2D (QR, Data Matrix, PDF417, Aztec, EAN, UPC, Code 39) · 2.4G y Bluetooth, 30-50 m · batería 2200 mAh, 7 h de uso · receptor USB plug and play · resiste caídas de 3 m' },
  { label: 'Impresora', value: 'Térmica de recibos de 3" · alta velocidad · USB y Ethernet integrados, Wi-Fi/Bluetooth opcional · salida de papel frontal o superior · bajo consumo de papel · carcasa resistente al agua y antimicrobiana' },
  { label: 'Cajón de efectivo', value: 'Acero laminado en frío · 5 ranuras para billetes y 8 para monedas, más 2 compartimentos inferiores · bloqueo de tres posiciones · apertura impulsada por la impresora · 410 × 420 × 100 mm' },
  { label: 'Pagos', value: 'Visa y Mastercard · crédito y débito · pago sin contacto (NFC) · 3D Secure' },
  { label: 'Conexión', value: 'WiFi y 4G' },
  { label: 'Canales', value: 'Sincroniza con Shopify, VTEX, WooCommerce, Prestashop y Ecwid' },
];

// El software es lo que sostiene la venta de este producto: el hardware se
// compara por precio, el inventario unificado no. Los puntos salen de lo que
// duele en un comercio que ya vende por varios canales.
const CAPABILITIES = [
  {
    icon: 'boxes',
    title: 'Un solo inventario',
    text: 'Tu tienda física, tu tienda en línea y tus ventas por redes descuentan del mismo stock. Se acabó vender algo que ya no tenías o recontar existencias cada noche.',
  },
  {
    icon: 'smartphone',
    title: 'Punto de venta táctil',
    text: 'Cobra en pocos toques, sin capacitación larga. Quien entra hoy al mostrador puede estar vendiendo en la misma jornada.',
  },
  {
    icon: 'shopping-bag',
    title: 'Órdenes',
    text: 'Consulta, edita y da seguimiento a cada orden desde el mismo lugar, sin importar por qué canal entró.',
  },
  {
    icon: 'refresh-cw',
    title: 'Devoluciones y cambios',
    text: 'Procesa una devolución en el mostrador aunque la compra se haya hecho en línea. El stock y el corte se ajustan solos.',
  },
  {
    icon: 'gift',
    title: 'Tarjetas de regalo',
    text: 'Vende y canjea tarjetas de regalo en cualquiera de tus canales, con el saldo siempre al día.',
  },
  {
    icon: 'store',
    title: 'Sucursales',
    text: 'Suma puntos de venta sin duplicar catálogos. Cada sucursal opera con su propio stock y tú ves el consolidado.',
  },
  {
    icon: 'piggy-bank',
    title: 'Cajas y cortes',
    text: 'Apertura, cierre y arqueo por caja y por turno. Sabes con qué cuadró cada quien sin perseguir a nadie.',
  },
  {
    icon: 'users',
    title: 'Usuarios y permisos',
    text: 'Cada quien ve lo que le toca. Define qué puede hacer cada cajero, supervisor o administrador.',
  },
  {
    icon: 'chart-line',
    title: 'Reportes',
    text: 'Qué se vende, en qué sucursal, a qué hora y quién lo vendió. Con datos para decidir qué reponer y qué dejar de comprar.',
  },
];

// Cada punto es una molestia concreta del día a día, no una lista de
// características. La solución se enuncia sin prometer números.
const PAIN_POINTS = [
  {
    problem: 'Vendes en línea y en el local con inventarios separados',
    solution: 'Un mismo catálogo y un mismo stock para los dos. Lo que sale del mostrador desaparece de la tienda en línea al instante.',
  },
  {
    problem: 'Cerrar caja te toma media hora y casi nunca cuadra',
    solution: 'El corte se arma solo con lo que pasó por el sistema: ventas, devoluciones y movimientos de efectivo por turno.',
  },
  {
    problem: 'No sabes qué producto te está dejando dinero',
    solution: 'Los reportes te muestran qué rota, en qué sucursal y a qué hora, para reponer con criterio y no por intuición.',
  },
  {
    problem: 'Cada canal nuevo significa otro sistema que aprender',
    solution: 'Tienda física, tienda en línea, links de pago y redes sociales operan desde la misma plataforma.',
  },
];

// El sistema es en la nube, así que el kit no es la única puerta de entrada.
// Decirlo evita perder a quien ya tiene equipo o apenas está arrancando y
// descarta el producto al ver solo el hardware.
const MODALIDADES = [
  {
    icon: 'shopping-cart',
    label: 'Con el kit completo',
    title: 'Todo listo, instalado por nosotros',
    text: 'Terminal, escáner, impresora y cajón. Un asesor técnico llega, lo instala y lo deja funcionando.',
    para: 'Para negocios con mostrador fijo y volumen constante.',
  },
  {
    icon: 'smartphone',
    label: 'Sin hardware',
    title: 'Solo con tu navegador o el app',
    text: 'Como el sistema es en la nube, puedes vender, emitir facturas y enviarlas por WhatsApp sin ningún equipo adicional.',
    para: 'Para quien está arrancando, tiene una operación simple o necesita vender en cualquier lugar.',
  },
  {
    icon: 'plug',
    label: 'Con tu propio equipo',
    title: 'Aprovecha lo que ya tienes',
    text: 'Puedes usar tu hardware si cumple las especificaciones técnicas mínimas, y cobrar con una terminal distinta a la de Qpaypro.',
    para: 'Consúltalo con tu asesor de ventas antes de comprar equipo.',
  },
];

// Giros donde el POS ya se usa. Cada uno enlaza a su página de sector, que es
// donde está el argumento completo; aquí solo se muestra que aplica.
const GIROS = [
  { slug: 'retail', label: 'Tiendas y retail', text: 'Ropa, calzado, librerías, ferreterías.', image: '/images/sectors/dd34e7d09e81.webp', alt: 'Vista de una tienda de ropa con mesas de exhibición y un cliente revisando prendas' },
  { slug: 'retail', label: 'Abarrotes y conveniencia', text: 'Alto volumen, cobro rápido, control de stock.', image: '/images/sectors/6634fe8542ee.webp', alt: 'Bolsa de compras con frutas, verduras y abarrotes' },
  { slug: 'belleza', label: 'Salones y barberías', text: 'Cobra por servicio en recepción.', image: '/images/sectors/e5ef95d38da9.webp', alt: 'Punto de venta Qpaypro instalado en la recepción de un salón de belleza' },
  { slug: 'servicios', label: 'Talleres y servicios', text: 'Órdenes de trabajo y cobros en sitio.', image: '/images/sectors/0f6e080a03e7.webp', alt: 'Técnico trabajando en un taller de reparación junto a una terminal de cobro' },
];

// Testimonios reales tomados de las páginas de sector: mismas personas, misma
// cita. No se inventa ninguno ni se les cambia el texto.
const TESTIMONIOS = [
  {
    quote: 'Ha sido la herramienta segura que le da confianza a mis clientes y que hizo crecer mis ventas.',
    name: 'Ana Lucía',
    image: '/images/sectors/5d04962f8c9e.webp',
    alt: 'Ana Lucía, dueña de una tienda, en su negocio',
  },
  {
    quote: 'Antes de conocer Qpaypro los cobros eran manuales y engorrosos: me robaban tiempo y generaban estrés. Hoy mis clientas pagan de forma práctica, con tarjeta de crédito y en cuotas, con un solo clic.',
    name: 'María Belén',
    image: '/images/sectors/826585492158.webp',
    alt: 'María Belén, propietaria de un negocio de servicios',
  },
];

const FAQ = [
  { q: '¿Cómo funciona el POS omnicanal de Qpaypro con las tiendas en línea?', a: 'El Sistema POS de Qpaypro sincroniza en tiempo real el inventario, los pagos físicos y la impresión de recibos con las ventas de tu tienda en línea (Shopify, VTEX, WooCommerce), unificando todo en una sola plataforma. Así vendes en el mostrador y en internet con el mismo catálogo y el mismo stock.' },
  { q: '¿Qué incluye el Sistema POS de Qpaypro?', a: 'Incluye terminal POS con pantalla táctil, escáner inalámbrico, impresora de recibos y cajón de efectivo. Todo llega listo para vender y cobrar con tarjeta desde el primer día.' },
  { q: '¿El POS acepta pagos con pago sin contacto?', a: 'Sí. Acepta Visa y Mastercard, crédito y débito, con pagos pago sin contacto (NFC) y validación 3D Secure para mayor seguridad.' },
  { q: '¿Puedo controlar mi inventario desde el POS?', a: 'Sí. El POS controla el stock en tiempo real, envía alertas de bajo inventario y organiza tu catálogo por categorías, sincronizado con tus ventas en línea.' },
  {
    q: '¿Puedo usar QPayPOS si no compro el hardware?',
    a: 'Sí. El sistema es en la nube, así que puedes vender, emitir facturas y enviarlas por WhatsApp sin ningún equipo adicional: solo necesitas un navegador o la app de Qpaypro en tu dispositivo móvil. Es la opción ideal para negocios que están arrancando, con un inventario y una operación más simples, o para vender en cualquier lugar.',
  },
  {
    q: '¿Puedo usar mi propio hardware o mi propia terminal de tarjeta?',
    a: 'Sí en los dos casos. Puedes usar tu propio equipo siempre que cumpla las especificaciones técnicas mínimas, así que conviene consultarlo con tu asesor de ventas antes de comprar nada. Y también puedes cobrar con una terminal de tarjeta distinta a la de Qpaypro; las tarifas por cobros con POS externo están en la página de precios.',
  },
  {
    q: '¿Cuánto cuesta el Sistema POS completo?',
    // Los precios viven en una sola página: repetirlos aquí obliga a
    // mantenerlos en dos lugares y a que uno de los dos quede desactualizado.
    a: 'Consulta los planes y precios vigentes en la página de precios, o escríbenos para una cotización a la medida de tu negocio.',
  },
];

export const getStaticPaths = countryPaths;
const country = Astro.params.country!;
const c = getCountry(country);

const VENTAS_HREF = `/${country}/contacto#ventas`;
const PRECIOS_HREF = `/${country}/precios`;

// Las nueve capacidades entran al catálogo del servicio: son las prestaciones
// que un asistente compara cuando le preguntan "¿qué punto de venta uso?", y
// hasta ahora solo existían como tarjetas de texto. El precio del kit se
// declara aparte y solo donde existe: en El Salvador `sistemaPosPrice` es
// null, y publicar un precio inventado es peor que no publicar ninguno.
const jsonLd: Record<string, unknown>[] = [
  servicio({
    nombre: `Sistema de punto de venta Qpaypro ${c.name}`,
    tipo: 'Sistema de punto de venta',
    descripcion: `Punto de venta para negocios en ${c.name}: cobra con tarjeta, controla inventario y sincroniza tu tienda física con la tienda en línea desde una sola plataforma.`,
    url: `/${country}/sistema-pos`,
    country: country as CountryCode,
    incluye: CAPABILITIES.map((capacidad) => capacidad.title),
  }),
  preguntasFrecuentes(FAQ),
];

if (c.sistemaPosPrice) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `Kit de punto de venta Qpaypro ${c.name}`,
    description: HARDWARE_PIECES.map((pieza) => pieza.title).join(', ') + '.',
    brand: { '@id': ID_ORGANIZACION },
    url: urlAbsoluta(`/${country}/sistema-pos`),
    offers: {
      '@type': 'Offer',
      price: c.sistemaPosPrice,
      priceCurrency: c.currency.code,
      availability: 'https://schema.org/InStock',
      url: urlAbsoluta(`/${country}/precios`),
      eligibleRegion: { '@type': 'Country', name: c.name },
    },
  });
}
---

<MainLayout
  title="Sistema POS: terminal, escáner, impresora y cajón | Qpaypro"
  description="Sistema de punto de venta completo: terminal táctil, escáner inalámbrico, impresora de recibos y cajón de efectivo. Sincronizado con tu tienda en línea."
  headerTheme="onDark"
>
  <section class="relative w-full bg-[#050506] overflow-hidden">
    <style>
      @keyframes sysPieceIn { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }
      .sys-piece { position: absolute; height: auto; opacity: 0; animation: sysPieceIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
      @media (prefers-reduced-motion: reduce) { .sys-piece { animation: none; opacity: 1; } }
      .sys-buy-d { position: absolute; right: 4.5%; bottom: 16%; z-index: 5; }
      .sys-buy-m { display: flex; justify-content: center; margin: 22px auto 4px; }
      .sys-buy-trigger { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-family: 'Manrope', sans-serif; background: rgba(17, 24, 39, 0.34); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(255, 255, 255, 0.26); border-radius: 14px; padding: 13px 24px; color: #fff; font-size: 14px; font-weight: 600; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.22); transition: 0.3s; }
      .sys-buy-trigger:hover { background: rgba(17, 24, 39, 0.5); transform: translateY(-2px); }
    </style>

    <div class="relative w-full hidden lg:block">
      <img src="/images/sistema-pos/ab32f5093859.webp" alt="Sistema de punto de venta Qpaypro" class="block w-full h-auto" />
      {PIECES.map((piece) => (
        <img src={piece.src} alt="" class="sys-piece" style={`left: ${piece.desktop.left}; top: ${piece.desktop.top}; width: ${piece.desktop.width}; animation-delay: ${piece.delay};`} />
      ))}
      <div class="sys-buy-d">
        <a href={VENTAS_HREF} class="sys-buy-trigger">
          <Icon name="message-circle" class="w-4 h-4" />
          Hablar con Ventas
        </a>
      </div>
    </div>

    <!-- Móvil: una sola toma vertical que llena la pantalla. No lleva las
         piezas flotantes porque esta imagen ya las trae compuestas; si se
         superpusieran, el escáner, la impresora y el cajón saldrían dos veces. -->
    <!-- El fondo continúa el beige del borde inferior de la foto (#a5968f, medido
         del propio archivo), así la sección llena la pantalla sin recortar la
         imagen: con object-cover en pantallas de 360 px se perdían la impresora
         y el receptor USB de los extremos. -->
    <div class="relative w-full lg:hidden min-h-[100svh] bg-[#a5968f]">
      <img
        src="/images/sistema-pos/605062be289f.webp"
        alt="Sistema de punto de venta Qpaypro"
        class="block w-full h-auto"
      />
      <!-- Anclado al 76% de la propia foto (la zona vacía del mostrador, bajo el
           cajón) en vez de al fondo del contenedor: así queda dentro de la
           pantalla tanto si la foto es más alta como más baja que el viewport. -->
      <div class="absolute inset-x-0 top-[76%] flex justify-center">
        <a href={VENTAS_HREF} class="sys-buy-trigger">
          <Icon name="message-circle" class="w-4 h-4" />
          Hablar con Ventas
        </a>
      </div>
    </div>

  </section>

  <section class="w-full bg-white py-24 lg:py-32">
    <div class="max-w-[1040px] mx-auto px-6 lg:px-8">
      <h2 class="text-center text-3xl md:text-4xl font-bold tracking-[-0.02em] leading-tight mb-14 lg:mb-16">
        <span class="text-[#0f206c]">Qué incluye. </span><span class="text-[#0047ba]">Cuatro piezas que trabajan como una sola.</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-6">
        {HARDWARE_PIECES.map((piece) => (
          <div class="text-center">
            <div class="mx-auto mb-5 h-[3px] w-9 rounded-full bg-gradient-to-r from-[#0047ba] to-[#0097ce]"></div>
            <h3 class="text-[#0f206c] text-lg font-semibold mb-2.5">{piece.title}</h3>
            <p class="text-[#6b7280] text-[15px] font-light leading-relaxed">{piece.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="w-full bg-white pb-24 lg:pb-32">
    <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="order-2 lg:order-1">
          <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">En tu mostrador</p>
          <h2 class="text-[#1a1d29] text-3xl md:text-4xl font-semibold tracking-[-0.03em] leading-[1.08] mb-6">
            Llega armado y listo para vender
          </h2>
          <p class="text-[#6b7280] text-lg leading-relaxed font-light mb-8">
            Llega armado y acompañado de un técnico que te ayuda en todo el proceso de instalación y configuración, y te deja todo
            listo para vender: cobrando con tarjeta, imprimiendo recibos y descontando del inventario que ya tienes.
          </p>
          <ul class="space-y-3.5">
            {['Nuestros asesores técnicos llegan y lo instalan por ti', 'Tu catálogo actual se carga y queda listo para vender', 'Funciona con WiFi o con datos móviles', 'Soporte local en tu mismo horario'].map((punto) => (
              <li class="flex items-start gap-3">
                <Icon name="circle-check" class="w-[18px] h-[18px] text-[#0a9d5a] flex-shrink-0 mt-0.5" strokeWidth={1.9} />
                <span class="text-[#4a4e58] text-[15px] leading-relaxed font-light">{punto}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="order-1 lg:order-2">
          <img
            src="/images/sectors/34d825ba261b.webp"
            alt="Sistema POS de Qpaypro completo sobre un mostrador: terminal táctil, escáner, impresora y cajón"
            width="1000"
            height="1081"
            loading="lazy"
            decoding="async"
            class="w-full h-auto rounded-[26px] ring-1 ring-black/[0.06]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="w-full bg-white pb-24 lg:pb-32">
    <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12 lg:mb-14">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Cómo empezar</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl font-semibold tracking-[-0.03em] leading-[1.08] mb-6">
          No necesitas comprar equipo para empezar
        </h2>
        <p class="text-[#6b7280] text-lg leading-relaxed font-light">
          QPayPOS vive en la nube. Puedes entrar con el kit completo, sin nada de hardware o con el equipo que ya tienes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6">
        {MODALIDADES.map((m) => (
          <div class="flex flex-col rounded-[22px] border border-black/[0.07] bg-white p-7 hover:shadow-[0_24px_60px_-32px_rgba(15,32,108,0.35)] transition-shadow duration-300">
            <div class="flex items-center gap-2.5 mb-5">
              <span class="w-9 h-9 rounded-lg bg-[#0047ba]/[0.07] flex items-center justify-center flex-shrink-0">
                <Icon name={m.icon as any} class="w-[18px] h-[18px] text-[#0047ba]" strokeWidth={1.8} />
              </span>
              <span class="text-[#0047ba] text-[11px] font-semibold uppercase tracking-[0.14em]">{m.label}</span>
            </div>
            <h3 class="text-[#0f206c] text-lg font-semibold mb-2.5 tracking-tight">{m.title}</h3>
            <p class="text-[#6b7280] text-[15px] font-light leading-relaxed mb-4 flex-1">{m.text}</p>
            <p class="text-[#8a8f9a] text-[13.5px] font-light leading-snug pt-4 border-t border-black/[0.06]">{m.para}</p>
          </div>
        ))}
      </div>

      <p class="text-center text-[#6b7280] text-[15px] font-light mt-9">
        Si cobras con una terminal distinta a la de Qpaypro, consulta las tarifas por cobros con POS externo en la{' '}
        <a href={PRECIOS_HREF} class="text-[#0047ba] font-medium hover:underline">página de precios</a>.
      </p>
    </div>
  </section>

  <section class="w-full bg-[#f5f6f8] py-24 lg:py-32">
    <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14 lg:mb-16">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">El software</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] leading-[1.05] mb-6">
          El equipo cobra. El sistema es el que hace crecer el negocio.
        </h2>
        <p class="text-[#6b7280] text-lg lg:text-xl leading-relaxed font-light">
          Todo lo que pasa en tu mostrador, tu tienda en línea y tus redes vive en la misma plataforma, con un solo inventario detrás.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
        {CAPABILITIES.map((cap) => (
          <div class="rounded-[22px] bg-white border border-black/[0.06] p-7 hover:shadow-[0_24px_60px_-32px_rgba(15,32,108,0.35)] hover:-translate-y-0.5 transition-all duration-300">
            <div class="w-11 h-11 rounded-xl bg-[#0047ba]/[0.07] flex items-center justify-center mb-5">
              <Icon name={cap.icon as any} class="w-5 h-5 text-[#0047ba]" strokeWidth={1.8} />
            </div>
            <h3 class="text-[#0f206c] text-lg font-semibold mb-2.5 tracking-tight">{cap.title}</h3>
            <p class="text-[#6b7280] text-[15px] font-light leading-relaxed">{cap.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative w-full overflow-hidden bg-[#050506] py-24 lg:py-32">
    <div class="absolute -top-40 right-0 w-[620px] h-[620px] rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(0, 151, 206, 0.3) 0%, transparent 70%);"></div>
    <div class="relative z-10 max-w-[1100px] mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="text-[#4ad2ff] text-xs font-semibold uppercase tracking-[0.22em] mb-5">La pantalla</p>
          <h2 class="text-white text-3xl md:text-4xl font-semibold tracking-[-0.03em] leading-[1.08] mb-6">
            Diseñado para vender rápido, no para estudiarlo
          </h2>
          <p class="text-white/65 text-lg leading-relaxed font-light mb-8">
            El catálogo a la izquierda, el ticket a la derecha y el cobro a un toque. Quien atiende encuentra el producto,
            lo suma y cobra sin salir de la misma pantalla, aunque sea su primer día.
          </p>
          <div class="flex flex-wrap gap-2.5">
            {['Búsqueda por nombre o código', 'Lectura con escáner', 'Descuentos y notas', 'Cobro con tarjeta o efectivo'].map((t) => (
              <span class="inline-flex items-center rounded-full bg-white/[0.06] border border-white/12 px-4 py-2 text-white/85 text-[13px] font-medium">{t}</span>
            ))}
          </div>
        </div>
        <div class="relative">
          <div class="absolute -inset-8 rounded-[40px] blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(0, 151, 206, 0.28) 0%, transparent 70%);"></div>
          <img
            src="/images/sistema-pos/b659d2c7fb02.webp"
            alt="Pantalla del punto de venta de Qpaypro con el catálogo de productos y el ticket de la venta en curso"
            width="807"
            height="757"
            loading="lazy"
            decoding="async"
            class="relative w-full h-auto rounded-[20px] ring-1 ring-white/12 shadow-[0_40px_100px_-40px_rgba(0,0,0,0.8)]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="w-full bg-white py-24 lg:py-32">
    <div class="max-w-[1000px] mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14 lg:mb-16">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Por qué importa</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] leading-[1.05]">
          Lo que hoy te quita tiempo
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6">
        {PAIN_POINTS.map((item) => (
          <div class="rounded-[22px] border border-black/[0.07] overflow-hidden">
            <div class="flex items-start gap-3 bg-[#fafbfc] px-6 py-5 border-b border-black/[0.06]">
              <Icon name="x" class="w-4 h-4 text-[#c0392b] flex-shrink-0 mt-1" strokeWidth={2.4} />
              <p class="text-[#1a1d29] text-[15px] font-medium leading-snug">{item.problem}</p>
            </div>
            <div class="flex items-start gap-3 px-6 py-5">
              <Icon name="circle-check" class="w-4 h-4 text-[#0a9d5a] flex-shrink-0 mt-1" strokeWidth={1.9} />
              <p class="text-[#4a4e58] text-[15px] font-light leading-relaxed">{item.solution}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 lg:mt-14 text-center">
        <a
          href={PRECIOS_HREF}
          class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-full font-semibold text-[15px] text-[#1a1d29] ring-1 ring-black/10 hover:ring-black/25 transition-all duration-300"
        >
          Ver planes y precios
          <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
        </a>
      </div>
    </div>
  </section>

  <section class="w-full bg-[#f5f6f8] py-24 lg:py-32">
    <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14 lg:mb-16">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Dónde funciona</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] leading-[1.05] mb-6">
          Hecho para el mostrador de tu giro
        </h2>
        <p class="text-[#6b7280] text-lg leading-relaxed font-light">
          El mismo sistema se acomoda a cómo vende cada negocio.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
        {GIROS.map((giro) => (
          <a
            href={`/${country}/${giro.slug}`}
            class="group block rounded-[22px] overflow-hidden bg-white border border-black/[0.06] hover:shadow-[0_24px_60px_-32px_rgba(15,32,108,0.35)] hover:-translate-y-0.5 transition-all duration-300"
          >
            <div class="relative aspect-[4/5] overflow-hidden bg-[#eef0f3]">
              <img
                src={giro.image}
                alt={giro.alt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500"
              />
            </div>
            <div class="p-5">
              <h3 class="text-[#0f206c] text-[15px] lg:text-base font-semibold mb-1.5 tracking-tight">{giro.label}</h3>
              <p class="text-[#6b7280] text-[13.5px] font-light leading-snug">{giro.text}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="w-full bg-white py-24 lg:py-32">
    <div class="max-w-[1000px] mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14 lg:mb-16">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Quienes ya cobran así</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] leading-[1.05]">
          Negocios que dejaron de cobrar a mano
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {TESTIMONIOS.map((t) => (
          <figure class="rounded-[24px] bg-[#f5f6f8] border border-black/[0.05] p-7 lg:p-8 flex flex-col">
            <Icon name="quote" class="w-7 h-7 text-[#0047ba]/25 mb-5" strokeWidth={1.5} />
            <blockquote class="text-[#1a1d29] text-[17px] lg:text-lg leading-[1.6] font-light flex-1">
              “{t.quote}”
            </blockquote>
            <figcaption class="flex items-center gap-3.5 mt-7 pt-6 border-t border-black/[0.07]">
              <img
                src={t.image}
                alt={t.alt}
                width="800"
                height="1000"
                loading="lazy"
                decoding="async"
                class="w-12 h-12 rounded-full object-cover object-top ring-1 ring-black/[0.06]"
              />
              <span class="text-[#0f206c] text-[15px] font-semibold">{t.name}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ConnectedPlatformDiagram />

  <section class="w-full bg-[#f5f6f8] py-24 lg:py-32">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12 lg:mb-14">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Especificaciones</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl font-semibold tracking-[-0.03em]">Ficha técnica del hardware</h2>
      </div>
      <div class="rounded-[24px] overflow-hidden border border-black/[0.07] bg-white">
        {SPECS.map((spec, i) => (
          <div class:list={["grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-1 sm:gap-4 px-6 py-4", i % 2 === 0 ? "bg-white" : "bg-[#fafbfc]"]}>
            <div class="text-[#0f206c] text-sm font-semibold">{spec.label}</div>
            <div class="text-[#4a4e58] text-[15px] font-light">{spec.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="w-full bg-white py-24 lg:py-32">
    {jsonLd.map((nodo) => <script type="application/ld+json" set:html={JSON.stringify(nodo)} />)}
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-14 lg:mb-16">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Preguntas frecuentes</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] leading-[1.04]">Preguntas frecuentes del Sistema POS</h2>
      </div>
      <div class="divide-y divide-black/[0.08] border-t border-black/[0.08]">
        {FAQ.map((item) => (
          <div class="py-7">
            <h3 class="text-[#1a1d29] text-lg lg:text-xl font-semibold mb-3 tracking-tight">{item.q}</h3>
            <p class="text-[#4a4e58] text-[15px] lg:text-base leading-relaxed font-light">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative w-full overflow-hidden bg-[#050506] py-24 lg:py-32">
    <div class="absolute -top-32 -left-24 w-[560px] h-[560px] rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(0, 71, 186, 0.4) 0%, transparent 70%);"></div>
    <div class="absolute -bottom-32 -right-16 w-[600px] h-[600px] rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(15, 32, 108, 0.45) 0%, transparent 70%);"></div>
    <div class="relative z-10 max-w-2xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-white text-4xl md:text-5xl font-semibold tracking-[-0.03em] leading-[1.05] mb-6">¿Listo para empezar?</h2>
      <p class="text-white/60 text-lg lg:text-xl leading-relaxed mb-11 font-light">Lleva el Sistema POS a tu negocio y empieza a cobrar, controlar tu inventario y vender desde un solo equipo.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={VENTAS_HREF} class="group inline-flex items-center gap-2 px-8 py-4 bg-white text-[#050506] rounded-full font-semibold text-base hover:bg-white/90 transition-colors duration-300">
          <Icon name="message-circle" class="w-4 h-4" />
          Hablar con Ventas
        </a>
        <a href={PRECIOS_HREF} class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-semibold text-base text-white ring-1 ring-white/25 hover:ring-white/50 transition-all duration-300">
          Ver planes y precios
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

</MainLayout>
