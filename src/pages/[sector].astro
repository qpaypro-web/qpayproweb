---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import ConnectedPlatformDiagram from '../components/ConnectedPlatformDiagram.astro';
import sectors from '../data/sectors.json';

export function getStaticPaths() {
  return Object.keys(sectors).map((sector) => ({
    params: { sector },
    props: { data: sectors[sector] },
  }));
}

const { data } = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<MainLayout title={data.title} description={data.description} headerTheme="onDark">
  <section class="relative w-full min-h-screen flex flex-col items-center justify-center pt-36 pb-24 lg:pt-40 lg:pb-32 text-center overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url("${data.hero.bgImage}");`}></div>
    <div class="absolute inset-0 bg-black/[0.65]"></div>
    <div class="absolute inset-0" style="background: linear-gradient(rgba(5, 5, 6, 0.3) 0%, rgba(5, 5, 6, 0.05) 42%, rgba(5, 5, 6, 0.4) 100%);"></div>
    <div class="relative z-10 max-w-[1000px] mx-auto px-6 lg:px-8">
      <h1 class="text-white text-3xl md:text-4xl lg:text-[2.5rem] font-semibold tracking-[-0.03em] leading-[1.05] mb-8" style="text-shadow: rgba(0, 0, 0, 0.4) 0px 2px 30px;">{data.hero.title}</h1>
      <p class="text-white/75 text-xl lg:text-2xl leading-relaxed max-w-xl mx-auto font-light mb-11" style="text-shadow: rgba(0, 0, 0, 0.4) 0px 1px 20px;">{data.hero.subtitle}</p>
      <div class="flex items-center justify-center gap-4 flex-wrap mb-8">
        <a href="precios.html" class="group px-8 py-4 bg-white text-[#050506] rounded-full font-semibold text-base hover:bg-white/90 transition-colors duration-300 flex items-center gap-2">
          {data.hero.ctaPrimary}
          <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
        <a href="contacto.html#ventas" class="px-8 py-4 bg-white/[0.10] backdrop-blur-md text-white rounded-full font-semibold text-base border border-white/30 hover:bg-white/20 hover:border-white/50 transition-all duration-300">{data.hero.ctaSecondary}</a>
      </div>
      <p class="text-white/50 text-sm font-light">{data.hero.footnote}</p>
    </div>
  </section>

  <section class="w-full bg-white py-20 lg:py-28 overflow-hidden">
    <style>
      @keyframes sectorMarquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      .sector-marquee { animation: sectorMarquee 45s linear infinite; width: max-content; }
      .sector-marquee-wrap:hover .sector-marquee { animation-play-state: paused; }
      @media (prefers-reduced-motion: reduce) { .sector-marquee { animation: none; } }
    </style>
    <div class="max-w-[1240px] mx-auto px-6 lg:px-8 mb-10 lg:mb-14">
      <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-6">{data.marquee.eyebrow}</p>
      <h2 class="text-[#1a1d29] text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-0.03em] leading-[1.02]">{data.marquee.heading}</h2>
    </div>
    <div class="sector-marquee-wrap relative w-full">
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-16 lg:w-28 z-10 bg-gradient-to-r from-white to-transparent"></div>
      <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-16 lg:w-28 z-10 bg-gradient-to-l from-white to-transparent"></div>
      <div class="sector-marquee flex gap-4 lg:gap-5">
        {[...data.marquee.cards, ...data.marquee.cards].map((card) => (
          <div class="group relative flex-shrink-0 w-[230px] sm:w-[250px] aspect-[5/7] rounded-2xl overflow-hidden">
            <img src={card.image} alt={card.alt} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]" />
            <div class="absolute inset-0 bg-black/45 transition-colors duration-300 group-hover:bg-black/35"></div>
            <div class="absolute inset-0 flex items-center justify-center px-5">
              <span class="text-white font-semibold text-xl text-center leading-snug">{card.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="w-full bg-[#f5f6f8] py-24 lg:py-32">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-16 lg:mb-24">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-6">{data.features.eyebrow}</p>
        <h2 class="text-[#1a1d29] text-4xl md:text-5xl lg:text-6xl font-semibold tracking-[-0.03em] leading-[1.02] mb-6">{data.features.heading}</h2>
        <p class="text-[#6b7280] text-lg lg:text-xl leading-relaxed font-light mx-auto">{data.features.desc}</p>
      </div>
      {data.features.blocks.map((block, i) => (
        <div class:list={["grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center", i > 0 && "mt-20 lg:mt-28"]}>
          <div class:list={[block.order === "reverse" && "lg:order-2"]}>
            <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">{block.eyebrow}</p>
            <h3 class="text-[#1a1d29] text-3xl md:text-4xl lg:text-[2.6rem] font-semibold tracking-[-0.03em] leading-[1.08] mb-5">{block.heading}</h3>
            <p class="text-[#6b7280] text-lg leading-relaxed font-light mb-7 max-w-lg">{block.desc}</p>
            <ul class="space-y-3">
              {block.bullets.map((bullet) => (
                <li class="flex items-center gap-3">
                  <span class="inline-flex w-5 h-5 rounded-full bg-[#0047ba]/10 items-center justify-center flex-shrink-0">
                    <Icon name="check" class="w-3 h-3 text-[#0047ba]" strokeWidth={3} />
                  </span>
                  <span class="text-[#3a3d47] text-[15px]">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class:list={["flex justify-center", block.order === "reverse" ? "lg:order-1 lg:justify-start" : "lg:justify-end"]}>
            <img src={block.image} alt="" class="w-full max-w-[460px] aspect-[4/5] object-cover rounded-[28px] shadow-[0_40px_90px_-30px_rgba(15,32,108,0.32)]" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <ConnectedPlatformDiagram />

  <section class="relative w-full overflow-hidden py-24 lg:py-32" style="background: linear-gradient(rgb(255, 255, 255) 0%, rgb(238, 242, 248) 100%);">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">{data.pos.eyebrow}</p>
          <h2 class="text-[#1a1d29] text-4xl md:text-5xl font-semibold tracking-[-0.03em] leading-[1.03] mb-6">{data.pos.heading}</h2>
          <p class="text-[#6b7280] text-lg leading-relaxed font-light mb-9 max-w-lg">{data.pos.desc}</p>
          <div class="space-y-5 mb-10">
            {data.pos.items.map((item) => (
              <div class="flex items-start gap-4">
                <span class="inline-flex w-11 h-11 rounded-2xl bg-[#050506] items-center justify-center flex-shrink-0">
                  <Icon name={item.icon} class="w-5 h-5 text-white" strokeWidth={1.75} />
                </span>
                <div>
                  <div class="text-[#1a1d29] text-base font-semibold mb-0.5">{item.title}</div>
                  <div class="text-[#6b7280] text-[15px] font-light leading-relaxed">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
          <a href={data.pos.ctaHref} class="group inline-flex items-center gap-2 px-7 py-3.5 bg-[#0047ba] text-white rounded-full font-semibold text-base hover:bg-[#0f206c] transition-colors duration-300">
            {data.pos.ctaText}
            <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
        <div class="relative flex justify-center">
          <img src={data.pos.image} alt="Sistema de punto de venta Qpaypro" class="relative w-full max-w-[500px] aspect-[4/5] object-cover rounded-[28px] shadow-[0_40px_90px_-30px_rgba(15,32,108,0.35)]" />
        </div>
      </div>
    </div>
  </section>

  <section class="w-full bg-white py-24 lg:py-32">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="rounded-[28px] overflow-hidden bg-[#f5f6f8] aspect-[4/3] lg:aspect-[5/6]">
          <img src={data.testimonial.image} alt={`Testimonio de ${data.testimonial.name}`} class="w-full h-full object-cover" />
        </div>
        <div>
          <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-6">Testimonios</p>
          <Icon name="quote" class="w-10 h-10 text-[#0047ba]/25 mb-5" strokeWidth={1.5} />
          <blockquote class="text-[#1a1d29] text-2xl lg:text-[2rem] font-light leading-[1.35] tracking-[-0.01em] mb-8">{data.testimonial.quote}</blockquote>
          <div class="flex items-center gap-4">
            <div class="w-1 h-11 rounded-full bg-gradient-to-b from-[#0047ba] to-[#0097ce] flex-shrink-0"></div>
            <div>
              <div class="text-[#1a1d29] font-semibold text-[15px]">{data.testimonial.name}</div>
              <div class="text-[#8a8f9a] text-sm">{data.testimonial.company}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="w-full bg-white py-24 lg:py-32">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-14 lg:mb-16">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">{data.faq.heading}</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] leading-[1.04]">{data.faq.heading}</h2>
      </div>
      <div class="divide-y divide-black/[0.08] border-t border-black/[0.08]">
        {data.faq.items.map((item) => (
          <div class="py-7">
            <h3 class="text-[#1a1d29] text-lg lg:text-xl font-semibold mb-3 tracking-tight">{item.q}</h3>
            <p class="text-[#4a4e58] text-[15px] lg:text-base leading-relaxed font-light">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative w-full overflow-hidden bg-[#050506] py-24 lg:py-32">
    <div class="absolute -top-32 -left-32 w-[620px] h-[620px] rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(0, 71, 186, 0.4) 0%, transparent 70%);"></div>
    <div class="absolute -bottom-40 -right-24 w-[680px] h-[680px] rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(15, 32, 108, 0.45) 0%, transparent 70%);"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(0, 151, 206, 0.14) 0%, transparent 70%);"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-y-12 sm:gap-x-8 sm:divide-x sm:divide-white/[0.10] mb-14 lg:mb-16">
        {data.final.statsTargets.map((stat) => (
          <div class="text-center px-6">
            <div>
              {stat.static ? (
                <div class="text-4xl lg:text-5xl xl:text-6xl font-semibold text-white tracking-[-0.04em] mb-4 tabular-nums">{stat.static}</div>
              ) : (
                <div
                  class="text-4xl lg:text-5xl xl:text-6xl font-semibold text-white tracking-[-0.04em] mb-4 tabular-nums"
                  data-count-up
                  data-target={stat.target}
                  data-suffix={stat.suffix}
                  data-format={stat.format}
                >
                  0{stat.suffix}
                </div>
              )}
              <div class="mx-auto mb-4 h-px w-8 bg-gradient-to-r from-[#0097ce] to-[#0047ba]"></div>
              <div class="text-white/45 text-xs lg:text-sm font-medium uppercase" style="letter-spacing: 0.16em;">{stat.label}</div>
            </div>
          </div>
        ))}
      </div>
      <div class="h-px w-full bg-white/[0.10] mb-14 lg:mb-16"></div>
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-white text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] leading-[1.05] mb-6">{data.final.heading}</h2>
        <p class="text-white/60 text-lg lg:text-xl leading-relaxed mb-11 max-w-xl mx-auto font-light">{data.final.desc}</p>
        <div class="flex items-center justify-center gap-4 flex-wrap">
          {data.final.ctas.map((cta, i) =>
            i === 0 ? (
              <a href={cta.href} class="group px-8 py-4 bg-white text-[#050506] rounded-full font-semibold text-base hover:bg-white/90 transition-colors duration-300 flex items-center gap-2">
                {cta.text}
                <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </a>
            ) : (
              <a href={cta.href} class="px-8 py-4 bg-white/[0.08] backdrop-blur-md text-white rounded-full font-semibold text-base border border-white/25 hover:bg-white/[0.14] hover:border-white/40 transition-all duration-300">
                {cta.text}
              </a>
            )
          )}
        </div>
      </div>
    </div>
  </section>
</MainLayout>
