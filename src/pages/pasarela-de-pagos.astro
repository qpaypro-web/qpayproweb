---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import GlowSectionDecor from '../components/GlowSectionDecor.astro';
import ConnectedPlatformDiagram from '../components/ConnectedPlatformDiagram.astro';

const PAYMENT_METHODS = [
  {
    num: '01',
    icon: 'credit-card',
    title: 'Pagos con tarjeta',
    text: 'Acepta Visa y Mastercard en tu negocio o a distancia, con pago sin contacto y pagos en cuotas.',
    points: ['Crédito y débito', 'Pago sin contacto y 3D Secure', 'Pagos en cuotas'],
  },
  {
    num: '02',
    icon: 'link2',
    title: 'Links de pago',
    text: 'Genera un link y cobra por WhatsApp, redes o correo. Tu cliente paga desde su celular al instante.',
    points: ['Cobra por WhatsApp y redes', 'Sin página web', 'Confirmación inmediata'],
  },
  {
    num: '03',
    icon: 'refresh-cw',
    title: 'Suscripciones',
    text: 'Automatiza mensualidades, membresías y planes con cobros frecuentes.',
    points: ['Cobros automáticos', 'Mensualidades y membresías', 'Menos morosidad'],
  },
  {
    num: '04',
    icon: 'shield-check',
    title: 'Seguridad',
    text: 'Cada transacción protegida con certificación de nivel bancario.',
    points: ['Certificación PCI-DSS', 'Protocolo 3D Secure', 'Prevención de fraude Qpayradar + Qpayverify'],
  },
];

const FAQ = [
  { q: '¿Qué formas de cobro ofrece Qpaypro?', a: 'Cobras con tarjeta (Visa y Mastercard, crédito y débito), con links de pago por WhatsApp, con suscripciones automáticas y en tu tienda en línea o física. Todo desde una sola plataforma.' },
  { q: '¿Puedo cobrar en cuotas?', a: 'Sí. Puedes ofrecer pagos en cuotas para que tus clientes compren montos más grandes con tarjeta de crédito.' },
  { q: '¿Es seguro cobrar con Qpaypro?', a: 'Sí. Cada cobro está protegido con certificación PCI-DSS, protocolo 3D Secure y prevención de fraude con Qpayradar y Qpayverify.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<MainLayout
  title="Pasarela de pagos: tarjeta, links y suscripciones | Qpaypro"
  description="Acepta tarjetas, cobra con links de pago y suscripciones — todo con Qpaypro. Pasarela de pagos certificada PCI-DSS para Guatemala y El Salvador."
  headerTheme="onDark"
>
  <section class="relative w-full bg-[#050506] overflow-hidden pt-40 pb-24 lg:pt-52 lg:pb-32">
    <GlowSectionDecor />
    <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[900px] h-[520px] blur-[130px] opacity-45 pointer-events-none" style="background: radial-gradient(circle, rgba(0, 71, 186, 0.55) 0%, transparent 70%);"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-3 mb-8">
        <span class="h-px w-8 bg-gradient-to-r from-transparent to-[#4ad2ff]/70"></span>
        <span class="text-[#4ad2ff] text-[11px] font-semibold uppercase tracking-[0.3em]">Soluciones de pago</span>
        <span class="h-px w-8 bg-gradient-to-l from-transparent to-[#4ad2ff]/70"></span>
      </div>
      <h1 class="text-white text-4xl md:text-5xl lg:text-[4rem] font-semibold tracking-[-0.04em] leading-[1.0] mb-7">Soluciones de pago para tu negocio.</h1>
      <p class="text-white/55 text-lg lg:text-xl font-light leading-relaxed max-w-xl mx-auto mb-11">Acepta tarjetas, cobra con links de pago y suscripciones — todo con Qpaypro.</p>
      <div class="flex items-center justify-center gap-3 flex-wrap">
        <a href="precios.html" class="group px-8 py-4 bg-white text-[#050506] rounded-full font-semibold text-[15px] hover:bg-white/90 transition-colors duration-300 inline-flex items-center gap-2">
          Comenzar ahora
          <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
        <a href="contacto.html#ventas" class="px-8 py-4 bg-white/[0.06] backdrop-blur-md text-white rounded-full font-semibold text-[15px] border border-white/20 hover:bg-white/[0.12] hover:border-white/35 transition-all duration-300">Hablar con ventas</a>
      </div>
    </div>
  </section>

  <section class="w-full bg-white py-24 lg:py-36">
    <div class="max-w-[1080px] mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-6 lg:gap-16 items-end mb-14 lg:mb-20">
        <div>
          <div class="inline-flex items-center gap-3 mb-6">
            <span class="h-px w-8 bg-gradient-to-r from-[#0047ba] to-[#0097ce]"></span>
            <span class="text-[#0047ba] text-[11px] font-semibold uppercase tracking-[0.28em]">Formas de cobro</span>
          </div>
          <h2 class="text-[#0f0f12] text-4xl md:text-5xl font-semibold tracking-[-0.035em] leading-[1.02]">Cobra como tu cliente prefiera</h2>
        </div>
        <p class="text-[#6b7280] text-lg font-light leading-relaxed lg:pb-2">Con tarjeta, por link, con suscripción o en tu tienda: todo queda conectado en una sola plataforma.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-5 lg:gap-6">
        {PAYMENT_METHODS.map((method) => (
          <div class="group relative rounded-[28px] border border-black/[0.07] bg-white p-8 lg:p-10 overflow-hidden transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[0_44px_90px_-46px_rgba(15,32,108,0.42)]">
            <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#0047ba]/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></span>
            <div class="flex items-start justify-between mb-7">
              <span class="inline-flex w-14 h-14 rounded-2xl items-center justify-center" style="background: linear-gradient(135deg, rgb(15, 32, 108), rgb(0, 151, 206)); box-shadow: rgba(0, 71, 186, 0.55) 0px 14px 30px -12px;">
                <Icon name={method.icon} class="w-6 h-6 text-white" strokeWidth={1.7} />
              </span>
              <span class="text-[5.5rem] leading-none font-bold tracking-[-0.05em] text-transparent bg-clip-text bg-gradient-to-b from-[#eef1f6] to-[#fbfcfd] select-none -mt-3 -mr-1">{method.num}</span>
            </div>
            <h3 class="text-[#0f0f12] text-2xl font-semibold tracking-[-0.02em] mb-3">{method.title}</h3>
            <p class="text-[#6b7280] text-[15px] leading-relaxed font-light mb-7">{method.text}</p>
            <ul class="space-y-2.5">
              {method.points.map((point) => (
                <li class="flex items-center gap-3">
                  <span class="inline-flex w-[18px] h-[18px] rounded-full bg-[#0047ba]/10 items-center justify-center flex-shrink-0">
                    <Icon name="check" class="w-2.5 h-2.5 text-[#0047ba]" strokeWidth={3.5} />
                  </span>
                  <span class="text-[#3a3d47] text-sm">{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ConnectedPlatformDiagram />

  <section class="w-full bg-white py-24 lg:py-32">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-14 lg:mb-16">
        <p class="text-[#0047ba] text-xs font-semibold uppercase tracking-[0.22em] mb-5">Preguntas frecuentes</p>
        <h2 class="text-[#1a1d29] text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] leading-[1.04]">Preguntas frecuentes</h2>
      </div>
      <div class="divide-y divide-black/[0.08] border-t border-black/[0.08]">
        {FAQ.map((item) => (
          <div class="py-7">
            <h3 class="text-[#1a1d29] text-lg lg:text-xl font-semibold mb-3 tracking-tight">{item.q}</h3>
            <p class="text-[#4a4e58] text-[15px] lg:text-base leading-relaxed font-light">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative w-full overflow-hidden bg-[#050506] py-24 lg:py-32">
    <GlowSectionDecor />
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[520px] h-[300px] blur-[120px] opacity-45 pointer-events-none" style="background: radial-gradient(circle, rgba(0, 71, 186, 0.5), transparent 70%);"></div>
    <div class="relative z-10 max-w-2xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-white text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.035em] leading-[1.05] mb-5">Empieza a cobrar con Qpaypro</h2>
      <p class="text-white/55 text-lg leading-relaxed mb-10 font-light max-w-lg mx-auto">Acepta tarjetas, links de pago y suscripciones hoy mismo.</p>
      <div class="flex items-center justify-center gap-3 flex-wrap">
        <a href="precios.html" class="group px-8 py-4 bg-white text-[#050506] rounded-full font-semibold text-[15px] hover:bg-white/90 transition-colors duration-300 inline-flex items-center gap-2">
          Comenzar ahora
          <Icon name="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
        <a href="contacto.html#ventas" class="px-8 py-4 bg-white/[0.06] backdrop-blur-md text-white rounded-full font-semibold text-[15px] border border-white/20 hover:bg-white/[0.12] transition-all duration-300">Hablar con ventas</a>
      </div>
    </div>
  </section>
</MainLayout>
