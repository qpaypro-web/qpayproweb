---
import MainLayout from '../../layouts/MainLayout.astro';
import Icon from '../../components/Icon.astro';
import articles from '../../data/blog-articles.json';

export function getStaticPaths() {
  const slugs = articles.map((a) => a.slug);
  return articles.map((article, index) => {
    const others = slugs.filter((s) => s !== article.slug);
    let related = others.slice(index, index + 3);
    if (related.length < 3) related = others.slice(0, 3);
    const relatedArticles = related.map((slug) => articles.find((a) => a.slug === slug));
    return { params: { slug: article.slug }, props: { article, relatedArticles } };
  });
}

const { article, relatedArticles } = Astro.props;
---

<MainLayout title={`${article.title} — Qpaypro`} description={article.body[0]?.t?.slice(0, 155) ?? article.title} headerTheme="onLight">
  <header class="w-full bg-white pt-32 lg:pt-40">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-[#6b7280] hover:text-[#0047ba] text-sm font-medium mb-7 transition-colors">
        <Icon name="arrow-left" class="w-4 h-4" />
        Volver al blog
      </a>
      <div class="flex flex-wrap gap-2 mb-5">
        {article.cats.map((cat) => (
          <span class="text-[10.5px] font-semibold uppercase tracking-wider text-[#0047ba] bg-[#0047ba]/[0.08] rounded-full px-3 py-1">{cat}</span>
        ))}
      </div>
      <h1 class="text-[#0f0f12] text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.035em] leading-[1.08] mb-9">{article.title}</h1>
    </div>
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="rounded-[24px] overflow-hidden bg-[#eef1f6] aspect-[16/9]">
        <img src={article.image} alt={article.title} class="w-full h-full object-cover" />
      </div>
    </div>
  </header>

  <article class="max-w-2xl mx-auto px-6 lg:px-8 py-16 lg:py-20">
    {article.body.map((block) =>
      block.h ? (
        <h2 class="text-[#0f0f12] text-2xl font-semibold tracking-tight mt-10 mb-4">{block.h}</h2>
      ) : (
        <p class="text-[#3a3d47] text-[17px] leading-[1.75] font-light mb-6">{block.t}</p>
      )
    )}
    {article.body.length <= 1 && <p class="text-[#8a8f9a] text-sm italic mt-4">Contenido completo en migración.</p>}
  </article>

  <section class="w-full bg-[#f5f6f8] py-16 lg:py-20 border-t border-black/[0.05]">
    <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
      <h2 class="text-[#1a1d29] text-2xl font-semibold tracking-tight mb-8">Sigue leyendo</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedArticles.map((related) => (
          <a href={`/blog/${related.slug}`} class="group rounded-2xl overflow-hidden bg-white border border-black/[0.06] hover:-translate-y-1 transition-all duration-300">
            <div class="aspect-[16/10] overflow-hidden bg-[#eef1f6]">
              <img src={related.image} alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-5">
              <h3 class="text-[#1a1d29] text-[15px] font-semibold leading-snug group-hover:text-[#0047ba] transition-colors">{related.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
