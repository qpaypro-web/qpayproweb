---
import MainLayout from '../../layouts/MainLayout.astro';
import Icon from '../../components/Icon.astro';
import articles from '../../data/blog-articles.json';
---

<MainLayout
  title="Blog Qpaypro: Ideas para cobrar, vender y crecer"
  description="Estrategias, tendencias y guías de pagos digitales y ecommerce para hacer crecer tu negocio."
  headerTheme="onLight"
>
  <section class="relative w-full bg-white pt-36 pb-14 lg:pt-44 lg:pb-16 text-center overflow-hidden border-b border-black/[0.05]">
    <div class="max-w-3xl mx-auto px-6 lg:px-8" data-reveal>
      <div class="inline-flex items-center gap-3 mb-6">
        <span class="h-px w-8 bg-gradient-to-r from-[#0047ba] to-[#0097ce]"></span>
        <span class="text-[#0047ba] text-[11px] font-semibold uppercase tracking-[0.28em]">Blog</span>
        <span class="h-px w-8 bg-gradient-to-l from-[#0047ba] to-[#0097ce]"></span>
      </div>
      <h1 class="text-[#0f0f12] text-4xl md:text-5xl font-semibold tracking-[-0.035em] leading-[1.03] mb-5">Ideas para cobrar, vender y crecer</h1>
      <p class="text-[#5c606b] text-lg lg:text-xl font-light leading-relaxed max-w-xl mx-auto">Estrategias, tendencias y guías de pagos digitales y ecommerce para hacer crecer tu negocio.</p>
    </div>
  </section>

  <section class="w-full bg-[#f5f6f8] py-20 lg:py-28">
    <div class="max-w-[1240px] mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {articles.map((article, i) => (
          <a
            href={`/blog/${article.slug}`}
            data-blog-card
            data-col={i % 3}
            class="group flex flex-col rounded-[24px] overflow-hidden bg-white border border-black/[0.07] transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[0_40px_80px_-44px_rgba(15,32,108,0.4)]"
          >
            <div class="aspect-[16/10] overflow-hidden bg-[#eef1f6]">
              <img src={article.image} alt={article.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.06]" />
            </div>
            <div class="flex flex-col flex-1 p-6">
              <div class="flex flex-wrap gap-2 mb-3.5">
                {article.cats.slice(0, 2).map((cat) => (
                  <span class="text-[10.5px] font-semibold uppercase tracking-wider text-[#0047ba] bg-[#0047ba]/[0.08] rounded-full px-2.5 py-1">{cat}</span>
                ))}
              </div>
              <h3 class="text-[#1a1d29] text-lg font-semibold leading-snug tracking-[-0.01em] mb-5 flex-1 group-hover:text-[#0047ba] transition-colors duration-300">{article.title}</h3>
              <span class="inline-flex items-center gap-1.5 text-[#0047ba] text-sm font-semibold">
                Leer artículo
                <Icon name="arrow-up-right" class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Faithful port of the original's per-card framer-motion reveal
    // (useInView, once: true, margin: "-40px") — each card animates
    // independently as it scrolls into view, staggered only by column
    // (r%3*0.08s), not by an accumulating group-wide stagger.
    document.querySelectorAll<HTMLElement>('[data-blog-card]').forEach((card) => {
      const delay = parseInt(card.dataset.col || '0', 10) * 0.08;
      card.style.opacity = '0';
      card.style.transform = 'translateY(22px)';
      card.style.transition = `opacity 0.5s cubic-bezier(0.22,1,0.36,1) ${delay}s, transform 0.5s cubic-bezier(0.22,1,0.36,1) ${delay}s`;
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) return;
          observer.disconnect();
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        },
        { rootMargin: '-40px' }
      );
      observer.observe(card);
    });
  </script>
</MainLayout>
