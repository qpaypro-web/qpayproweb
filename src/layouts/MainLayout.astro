---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  headerTheme?: 'onDark' | 'onLight';
  ogType?: string;
  ogLocale?: string;
}

const { title, description, headerTheme = 'onLight', ogType = 'website', ogLocale = 'es_GT' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="index, follow" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&display=swap');
      @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap');
    </style>
  </head>
  <body class="min-h-screen">
    <Header theme={headerTheme} />
    <slot />
    <Footer />
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Entrance reveal: a longer rise with a softer settle than the original
      // 0.3s/20px version, which barely registered while scrolling.
      //
      // Deliberately an IntersectionObserver rather than gsap.from() +
      // ScrollTrigger. ScrollTrigger auto-refreshes on `load`, and on a
      // refresh GSAP re-applies a `from` tween's start state; if that
      // trigger had already fired it never fires again, so the element
      // stays at opacity 0 permanently. That was already happening on
      // sobre-qpaypro before these changes (five cards never appeared).
      // Driving it from an observer also means the markup is visible by
      // default and only hidden once the script is definitely running.
      //
      // Groups stagger their children; a standalone [data-reveal] animates
      // on its own. Every standalone marker used to be inert, which is why
      // most section headings had no entrance at all.
      const revealBatches: HTMLElement[][] = [];
      document.querySelectorAll<HTMLElement>('[data-reveal-group]').forEach((group) => {
        const items = Array.from(group.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (items.length) revealBatches.push(items);
      });
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        if (!el.closest('[data-reveal-group]')) revealBatches.push([el]);
      });

      const RISE = reduceMotion ? 0 : 38;
      const DURATION = reduceMotion ? 200 : 750;
      const STAGGER = reduceMotion ? 0 : 120;

      revealBatches.forEach((items) => {
        items.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = `translateY(${RISE}px)`;
          el.style.transition = `opacity ${DURATION}ms cubic-bezier(0.22, 1, 0.36, 1) ${i * STAGGER}ms, transform ${DURATION}ms cubic-bezier(0.22, 1, 0.36, 1) ${i * STAGGER}ms`;
        });

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            observer.disconnect();
            items.forEach((el) => {
              el.style.opacity = '1';
              el.style.transform = 'translateY(0)';
              // Hand the element back to CSS once it has arrived, so nothing
              // is left with inline transforms that could fight a hover state.
              window.setTimeout(
                () => {
                  el.style.removeProperty('opacity');
                  el.style.removeProperty('transform');
                  el.style.removeProperty('transition');
                },
                DURATION + STAGGER * items.length + 60
              );
            });
          },
          { rootMargin: '0px 0px -12% 0px' }
        );
        items.forEach((el) => observer.observe(el));
      });

      if (!reduceMotion) {
        // Parallax. 'cover' is for images that fill a clipped container: they
        // get scaled up first so the drift stays inside the frame and can
        // never overlap neighbouring content. Anything else drifts by a few
        // pixels, well within the sections' vertical padding.
        document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
          const cover = el.dataset.parallax === 'cover';
          const trigger = cover ? el.parentElement || el : el;
          if (cover) {
            gsap.set(el, { scale: 1.18, transformOrigin: 'center center' });
          }
          gsap.fromTo(
            el,
            cover ? { yPercent: -7 } : { y: 34 },
            {
              ...(cover ? { yPercent: 7 } : { y: -34 }),
              ease: 'none',
              scrollTrigger: {
                trigger,
                start: 'top bottom',
                end: 'bottom top',
                scrub: 0.6,
              },
            }
          );
        });

        // Hero media settles back and dims as the hero scrolls away, so the
        // section below feels like it slides over it.
        document.querySelectorAll<HTMLElement>('[data-scroll-zoom]').forEach((el) => {
          gsap.fromTo(
            el,
            { scale: 1.06 },
            {
              scale: 1,
              opacity: 0.55,
              ease: 'none',
              scrollTrigger: {
                trigger: el.closest('section') || el.parentElement || el,
                start: 'top top',
                end: 'bottom top',
                scrub: 0.6,
              },
            }
          );
        });
      }

      // Faithful port of the original count-up stat component: same
      // IntersectionObserver threshold (0.4), same 1800ms duration, and the
      // same exponential ease-out curve (1 - 2^(-10k)), triggered once.
      document.querySelectorAll<HTMLElement>('[data-count-up]').forEach((el) => {
        const target = parseFloat(el.dataset.target || '0');
        const suffix = el.dataset.suffix || '';
        const decimals = parseInt(el.dataset.decimals || '0', 10);
        // 'locale' -> value.toLocaleString('es-GT') (thousand separators, e.g. "5,000")
        // 'plain'  -> String(value), no separators (e.g. a bare year like "2017")
        const format = el.dataset.format || 'locale';
        const scale = decimals ? 10 : 1;
        const internalTarget = target * scale;
        const duration = 1800;

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries[0].isIntersecting) return;
            observer.disconnect();
            const start = performance.now();
            function tick(now: number) {
              const k = Math.min((now - start) / duration, 1);
              const eased = k === 1 ? 1 : 1 - Math.pow(2, -10 * k);
              const value = Math.round(eased * internalTarget);
              const formatted = decimals
                ? (value / 10).toFixed(1)
                : format === 'plain'
                  ? String(value)
                  : value.toLocaleString('es-GT');
              el.textContent = formatted + suffix;
              if (k < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
          },
          { threshold: 0.4 }
        );
        observer.observe(el);
      });

      // ScrollTrigger measures every trigger's position once, on setup. Images
      // and webfonts land after that and push the layout down, so any trigger
      // whose real position ends up past its stale offset simply never fires —
      // which left a few cards stuck at opacity 0 for good. Re-measure once
      // everything that can change the layout has settled.
      const refresh = () => ScrollTrigger.refresh();
      window.addEventListener('load', refresh);
      document.fonts?.ready.then(refresh);
      document.querySelectorAll('img').forEach((img) => {
        if (!img.complete) img.addEventListener('load', refresh, { once: true });
      });
    </script>
  </body>
</html>
